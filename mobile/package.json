{
  "name": "@glidecomp/mobile",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "main": "expo-router/entry",
  "scripts": {
    "prepare-sources": "bun run --cwd .. engine:fingerprint --quiet && bun scripts/bundle-engine-sample.ts",
    "start": "bun run prepare-sources && expo start",
    "ios": "bun run prepare-sources && expo run:ios",
    "android": "bun run prepare-sources && expo run:android",
    "test": "bun run prepare-sources && jest",
    "typecheck": "bun run prepare-sources && tsc --noEmit",
    "e2e": "maestro test .maestro",
    "seed:submit": "bun scripts/seed-submit-comp.ts"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.10",
    "@better-auth/expo": "1.7.10",
    "@expo/log-box": "~58.0.9",
    "@expo/metro-runtime": "~58.0.14",
    "@expo/ui": "~58.0.15",
    "@glidecomp/client": "workspace:*",
    "@glidecomp/engine": "workspace:*",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@rnmapbox/maps": "^10.3.7",
    "@tanstack/query-async-storage-persister": "^5.104.4",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-query-persist-client": "^5.104.4",
    "better-auth": "^1.7.10",
    "expo": "~58.0.7",
    "expo-apple-authentication": "~58.0.2",
    "expo-constants": "~58.0.10",
    "expo-crypto": "~58.0.6",
    "expo-file-system": "~58.0.8",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.11",
    "expo-network": "~58.0.3",
    "expo-router": "~58.0.17",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.16",
    "expo-splash-screen": "~58.0.7",
    "expo-sqlite": "~58.0.11",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.5",
    "expo-web-browser": "~58.0.6",
    "fflate": "^0.8.3",
    "hono": "^4.13.13",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-native": "0.88.0-rc.4",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.28.0",
    "react-native-svg": "15.15.5"
  },
  "devDependencies": {
    "@glidecomp/samples": "workspace:*",
    "@react-native/jest-preset": "0.88.0-rc.4",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "~19.3.0",
    "jest": "^30.0.0",
    "jest-expo": "~58.0.9",
    "test-renderer": "^1.3.1"
  }
}
