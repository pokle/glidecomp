/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy-Report-Only: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data: blob: https://*.tile.openstreetmap.org https://*.tile.opentopomap.org https://server.arcgisonline.com https://api.mapbox.com; connect-src 'self' https://api.mapbox.com https://events.mapbox.com; worker-src 'self' blob:; child-src 'self' blob:; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com

# Build output — every filename in these two directories carries a content
# hash (Vite emits `app-CHvJv1_e.js`, Astro emits `Base.CvppkQhU.css`), so a
# changed file is always a changed URL and these can never need revalidating.
# Without this they inherit Cloudflare Pages' default for static assets,
# `public, max-age=14400, must-revalidate`, which makes a returning visitor
# re-validate every asset on every page: a ten-page journey measured 108 wire
# requests, 47 of them 304s that returned no data. With `immutable` the same
# journey is 61 requests and zero 304s — see
# docs/2026-07-27-network-request-audit.md.
#
# This is safe ONLY because the names are hashed. Do not extend it to the
# unhashed paths (/screenshots/*, /icon.svg, /manifest.webmanifest, /data/*):
# a year-long immutable cache on a stable URL is unfixable from the server.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
