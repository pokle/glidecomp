---
/**
 * Use GlideComp from your AI assistant (docs/mcp.md): how to connect Claude,
 * ChatGPT or Claude Code to the MCP endpoint, what an assistant may do, and
 * how to disconnect it. Linked from the footer's Resources column, from
 * Settings → Connected AI Assistants, from /llms.txt and from the MCP server
 * card's websiteUrl.
 *
 * Everything a reader needs is in the prerendered HTML; the Copy button is
 * the only script, and without it the address is still there to select.
 */
import Base from "../layouts/Base.astro";
import BackLink from "../components/BackLink.astro";

const MCP_URL = "https://glidecomp.com/mcp";
---

<Base
  title="Use GlideComp from your AI assistant"
  description="Connect Claude, ChatGPT or Claude Code to GlideComp, and ask it about your competitions in your own words."
>
  <div class="min-h-screen bg-background text-foreground py-6 px-page-safe">
    <div class="max-w-2xl mx-auto">
      <header class="mb-10">
        <BackLink href="/" />
        <h1 class="text-3xl font-bold">Use GlideComp from your AI assistant</h1>
        <p class="mt-4 leading-relaxed text-muted-foreground">
          Connect the AI assistant you already use (Claude, ChatGPT or Claude Code) and ask it about
          your competitions in your own words: find a competition, read a task, or set tomorrow's
          route. GlideComp runs no AI of its own. The assistant is yours.
        </p>
      </header>

      <div class="space-y-10 leading-relaxed">
        <section aria-labelledby="connect">
          <h2 id="connect" class="text-2xl font-bold mb-4">Connect</h2>
          <p>Your assistant needs one address:</p>
          <p class="my-4 flex flex-wrap items-center gap-3">
            <code id="mcp-url" class="rounded-md border bg-secondary px-3 py-2 font-mono text-base font-semibold break-all">{MCP_URL}</code>
            <button
              type="button"
              data-copy="mcp-url"
              hidden
              class="rounded-md border px-3 py-1.5 text-sm font-medium transition-colors hover:bg-secondary focus-visible:outline-2 focus-visible:outline-offset-2"
            >
              Copy
            </button>
            <span data-copy-status role="status" class="text-sm text-muted-foreground"></span>
          </p>
          <ul class="list-disc pl-6 space-y-2">
            <li>
              <strong>Claude</strong> (claude.ai and the Claude apps): in Claude's settings, add a custom
              connector and paste the address.
            </li>
            <li>
              <strong>ChatGPT:</strong> in ChatGPT's settings, add a connector with the address, if your
              plan offers custom connectors.
            </li>
            <li>
              <strong>Claude Code:</strong> run{" "}
              <code class="font-mono text-sm break-all">claude mcp add --transport http glidecomp {MCP_URL}</code>,
              then run <code class="font-mono text-sm">/mcp</code> and choose GlideComp.
            </li>
          </ul>
          <p class="mt-4">
            Your assistant then opens GlideComp in your browser. Sign in, check the assistant's name and
            the address it will return to, and choose <strong>Allow</strong>.
          </p>
        </section>

        <section aria-labelledby="can-do">
          <h2 id="can-do" class="text-2xl font-bold mb-4">What it can do</h2>
          <p>Your assistant acts as you. It sees what you can see on GlideComp, and nothing more.</p>
          <ul class="mt-3 list-disc pl-6 space-y-2">
            <li>See competitions and tasks, including hidden ones you organise.</li>
            <li>If you allow it: create tasks and change their routes in competitions you organise.</li>
          </ul>
          <p class="mt-3">
            It can't delete anything, or change competition settings, the pilot list, tracks, penalties
            or scores.
          </p>
        </section>

        <section aria-labelledby="ask">
          <h2 id="ask" class="text-2xl font-bold mb-4">Things to ask it</h2>
          <ul class="list-disc pl-6 space-y-2">
            <li>"What's the route for task 3 at the Corryong Cup?"</li>
            <li>"Which tasks fly through Mt Elliot?"</li>
            <li>"Make a task for tomorrow: Elliot, Towong, then goal at Corryong, start at 1:30."</li>
          </ul>
        </section>

        <section aria-labelledby="in-charge">
          <h2 id="in-charge" class="text-2xl font-bold mb-4">You stay in charge of your changes</h2>
          <ul class="list-disc pl-6 space-y-2">
            <li>It never guesses a waypoint. If a name could mean more than one, it asks you.</li>
            <li>It won't overwrite a route that someone changed on the website after it last looked.</li>
            <li>
              Every change is in the competition's activity log under your name, marked with the
              assistant's name, for example "(via Claude)".
            </li>
          </ul>
        </section>

        <section aria-labelledby="disconnect">
          <h2 id="disconnect" class="text-2xl font-bold mb-4">Disconnect</h2>
          <p>
            <a href="/settings#connected-ai-assistants" class="font-semibold underline underline-offset-2">Settings → Connected AI Assistants</a>{" "}
            lists every assistant you've allowed. <strong>Disconnect</strong> stops it straight away.
          </p>
        </section>

        <section aria-labelledby="developers">
          <h2 id="developers" class="text-2xl font-bold mb-4">For developers</h2>
          <p>GlideComp publishes its MCP server in the formats assistants look for:</p>
          <ul class="mt-3 list-disc pl-6 space-y-2">
            <li><a href="/llms.txt" class="underline underline-offset-2">llms.txt</a>: a guide to this site for AI models</li>
            <li><a href="/mcp/server-card" class="underline underline-offset-2">MCP server card</a>: what the server is and where to connect</li>
            <li>
              <a href="/.well-known/ard.json" class="underline underline-offset-2">Agentic Resource Discovery manifest</a>{" "}
              and <a href="/.well-known/ai-catalog.json" class="underline underline-offset-2">AI Catalog</a>: lists of
              the server card, for assistants that look these up
            </li>
            <li>
              <a href="https://github.com/pokle/glidecomp/blob/master/docs/mcp.md" class="underline underline-offset-2">How it works</a>:
              the technical documentation
            </li>
          </ul>
        </section>
      </div>
    </div>
  </div>
</Base>

<script>
  // The Copy button is an addition, not the content: it stays hidden until
  // this runs, so a reader without JavaScript sees the address and no dead
  // button.
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    const source = document.getElementById(button.dataset.copy ?? "");
    const status = button.parentElement?.querySelector<HTMLElement>("[data-copy-status]");
    if (!source || !navigator.clipboard) continue;
    button.hidden = false;
    button.addEventListener("click", () => {
      void navigator.clipboard.writeText(source.textContent?.trim() ?? "").then(() => {
        if (status) status.textContent = "Copied";
        setTimeout(() => {
          if (status) status.textContent = "";
        }, 2000);
      });
    });
  }
</script>
