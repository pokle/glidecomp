---
/**
 * GAP scoring guide. Ported from react/pages/ScoringGap.tsx.
 *
 * The React version typeset formulas client-side with renderMathInElement.
 * Here every formula is prerendered to static HTML+CSS with katex at build
 * time (km() below), so the page ships zero client JS — the math is baked in.
 */
import Base from "../../layouts/Base.astro";
import BackLink from "../../components/BackLink.astro";
import SpecRef from "../../components/SpecRef.astro";
import katex from "katex";
import "katex/dist/katex.min.css";

/** Render an inline (non-display) KaTeX expression to a static HTML string. */
const km = (tex: string) => katex.renderToString(tex, { displayMode: false, throwOnError: false });

const S7A_PDF =
  "https://www.fai.org/sites/default/files/civl/documents/sporting_code_s7_a_-_cross_country_2025.pdf";
---

<Base title="GlideComp - How GAP Scoring Works">
  <div class="min-h-screen bg-background text-foreground py-6 px-page-safe">
    <div class="max-w-2xl mx-auto">
      <header class="mb-10">
        <BackLink href="/scoring" label="Scoring" />
        <h1 class="text-3xl font-bold flex items-center gap-3">
          <img src="/icon.svg" alt="GlideComp logo" class="w-8 h-8" />
          How GAP Scoring Works
        </h1>
        <p class="text-muted-foreground mt-1">
          A guide to competition scoring for paragliding and hang gliding pilots
        </p>
      </header>

      {/* Table of Contents */}
      <nav class="mb-10 p-4 rounded-lg border border-border bg-card">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-muted-foreground mb-2">
          Contents
        </h2>
        <ul class="space-y-1 text-sm">
          <li><a href="#what-is-gap" class="hover:underline">What is GAP?</a></li>
          <li><a href="#how-a-task-works" class="hover:underline">How a Task Works</a></li>
          <li><a href="#task-validity" class="hover:underline">Task Validity</a></li>
          <li><a href="#scoring-components" class="hover:underline">The Four Scoring Components</a></li>
          <li><a href="#distance-points" class="hover:underline">Distance Points</a></li>
          <li><a href="#time-points" class="hover:underline">Time Points</a></li>
          <li><a href="#leading-points" class="hover:underline">Leading Points</a></li>
          <li><a href="#arrival-points" class="hover:underline">Arrival Points</a></li>
          <li><a href="#total-score" class="hover:underline">Your Total Score</a></li>
          <li><a href="#stopped-tasks" class="hover:underline">Stopped Tasks</a></li>
          <li><a href="#ftv" class="hover:underline">Series scoring &amp; FTV</a></li>
          <li><a href="#defaults" class="hover:underline">Default Competition Settings</a></li>
          <li><a href="#glidecomp-notes" class="hover:underline">GlideComp Implementation Notes</a></li>
          <li><a href="#spec-differences" class="hover:underline">Differences from the Official Specification</a></li>
          <li><a href="#references" class="hover:underline">Official References</a></li>
        </ul>
      </nav>

      {/* What is GAP? */}
      <section id="what-is-gap" class="mb-14">
        <div class="flex items-baseline justify-between gap-3 flex-wrap mb-4">
          <h2 class="text-2xl font-bold">What is GAP?</h2>
          <SpecRef section="2" label="FAI S7F §2" class="text-xs font-medium text-muted-foreground shrink-0" />
        </div>
        <div class="space-y-4 text-sm leading-relaxed">
          <p class="text-muted-foreground">
            GAP is the scoring system used by most paragliding (PG) and hang gliding (HG)
            cross-country competitions in the world. It is maintained by
            <a href="https://www.fai.org/commission/civl" target="_blank" rel="noopener noreferrer" class="underline hover:text-foreground">FAI/CIVL</a>,
            the international body for free-flight sports, and fully defined in
            <strong>Section 7F of the FAI Sporting Code</strong>.
          </p>
          <p class="text-muted-foreground">
            The name comes from the three people who designed it in the early 2000s: Gerolf
            Heinrichs, Angelo Crapanzano and Paul Mollison. CIVL has refined it many times since.
          </p>
          <p class="text-muted-foreground">
            The core idea: <strong>a perfect task is worth 1000 points</strong>. GAP splits those
            points into four categories (distance, time, leading and arrival), and each pilot
            earns a share of each depending on how they did against the rest of the field. A
            day that falls short of ideal, because few pilots launched or nobody got far, is
            worth less than 1000.
          </p>
        </div>
      </section>

      {/* How a Task Works */}
      <section id="how-a-task-works" class="mb-14">
        <div class="flex items-baseline justify-between gap-3 flex-wrap mb-4">
          <h2 class="text-2xl font-bold">How a Task Works</h2>
          <SpecRef section="6" label="FAI S7F §6" class="text-xs font-medium text-muted-foreground shrink-0" />
        </div>
        <div class="space-y-4 text-sm leading-relaxed">
          <p class="text-muted-foreground">
            If you've never flown a competition task, here's how one is put together.
          </p>
          <p class="text-muted-foreground">
            The task committee sets a route as a series of <strong>turnpoints</strong>. Each is a
            GPS position with a cylinder around it, and pilots must fly into each cylinder in
            order. A typical task has these parts:
          </p>
          <ul class="list-disc list-inside text-muted-foreground space-y-2 ml-2">
            <li>
              <strong>Launch</strong>: where pilots take off. You must launch to get a score.
            </li>
            <li>
              <strong>Start of Speed Section (SSS)</strong>: where your timed run begins. In a
              race, your clock starts at a fixed <em>start gate</em> time: the last gate at or
              before you crossed. In a time trial (also called elapsed time), it starts when you
              cross the cylinder.
            </li>
            <li>
              <strong>Turnpoints</strong>: the waypoints in between, tagged in order by flying
              into their cylinders. Radii are usually 400 m to 2 km.
            </li>
            <li>
              <strong>End of Speed Section (ESS)</strong>: the finish line for timing, where your
              clock stops. It is often the last turnpoint before goal.
            </li>
            <li>
              <strong>Goal</strong>: the final turnpoint. Reach it and you've completed the task.
              In PG you must reach goal to get any time points; ESS alone isn't enough. A task can
              also set an <a href="#elevated-goal" class="underline hover:text-foreground">elevated
              goal</a>, which is the ESS as well.
            </li>
          </ul>
          <p class="text-muted-foreground">
            A turnpoint can also have <strong>altitude limits</strong> (<SpecRef section="6.2.1" />).
            A crossing then counts only if your altitude is within them, give or take 5 m
            (<SpecRef section="9.2.1" />); the report card tells you when one didn't count. Goal
            can't have altitude limits.
          </p>
          <p class="text-muted-foreground">
            Your <strong>speed section time</strong> runs from crossing SSS to reaching ESS. Your
            <strong>flown distance</strong> is measured along the optimised route, through the
            turnpoints you reached.
          </p>
        </div>
      </section>

      {/* Task Validity */}
      <section id="task-validity" class="mb-14">
        <div class="flex items-baseline justify-between gap-3 flex-wrap mb-4">
          <h2 class="text-2xl font-bold">Task Validity</h2>
          <SpecRef section="10" label="FAI S7F §10" class="text-xs font-medium text-muted-foreground shrink-0" />
        </div>
        <div class="space-y-4 text-sm leading-relaxed">
          <p class="text-muted-foreground">
            Not every day deserves the full 1000 points. If conditions were poor and most pilots
            landed near launch, the day should count for less in the competition. GAP handles
            this with <strong>task validity</strong>: a multiplier between 0 and 1 that scales the
            points on offer.
          </p>
          <p class="text-muted-foreground">
            Task validity is the product of three separate validities:
          </p>

          <div class="ml-2 space-y-4">
            <div>
              <h3 class="text-base font-semibold mb-1">Launch Validity</h3>
              <p class="text-muted-foreground">
                Launch validity drops when fewer pilots launch than expected. It is 1.0 when more
                than 96% of the pilots present launch (the specification's "nominal launch"),
                and falls steeply if, say, half the field stays on the ground. A task only a few
                pilots flew can't be worth much.
              </p>
              <p class="text-muted-foreground mt-2">
                "Pilots present" means everyone not marked <strong>Absent</strong>: pilots who
                flew and uploaded a track, plus pilots who were there but marked <strong>Did Not
                Fly</strong>. Organisers set these on each task's roll call.
              </p>
            </div>
            <div>
              <h3 class="text-base font-semibold mb-1">Distance Validity</h3>
              <p class="text-muted-foreground">
                Distance validity drops when pilots don't get far compared with the expected task
                distance. It looks at the spread of distances the whole field flew. If most
                pilots landed near launch, the task probably wasn't a fair test, and it is worth
                less.
              </p>
            </div>
            <div>
              <h3 class="text-base font-semibold mb-1">Time Validity</h3>
              <p class="text-muted-foreground">
                Time validity drops when the fastest time is much shorter than the expected task
                duration, the "nominal time" (usually 90 minutes). A very short winning time
                suggests the task was too easy or conditions were unusual.
              </p>
            </div>
          </div>

          <p class="text-muted-foreground">Overall task validity is:</p>
          <p class="bg-muted/50 rounded px-3 py-2 inline-block" set:html={km(String.raw`\text{Task Validity} = \text{Launch Validity} \times \text{Distance Validity} \times \text{Time Validity}`)}></p>
          <p class="text-muted-foreground">and the points available for the task are:</p>
          <p class="bg-muted/50 rounded px-3 py-2 inline-block" set:html={km(String.raw`\text{Available Points} = 1000 \times \text{Task Validity}`)}></p>
          <p class="text-muted-foreground">
            On a good day, task validity is close to 1.0 and the task offers nearly 1000 points.
            On a poor day it might offer only 200 to 400.
          </p>
        </div>
      </section>

      {/* The Four Scoring Components */}
      <section id="scoring-components" class="mb-14">
        <div class="flex items-baseline justify-between gap-3 flex-wrap mb-4">
          <h2 class="text-2xl font-bold">The Four Scoring Components</h2>
          <SpecRef section="11" label="FAI S7F §11" class="text-xs font-medium text-muted-foreground shrink-0" />
        </div>
        <div class="space-y-4 text-sm leading-relaxed">
          <p class="text-muted-foreground">
            GAP splits the available points four ways. The split depends on the fraction of
            pilots who made goal, called the <strong>goal ratio</strong>.
          </p>
          <ul class="list-disc list-inside text-muted-foreground space-y-2 ml-2">
            <li>
              <strong>Distance Points</strong> reward how far you flew. They are always the
              largest share.
            </li>
            <li>
              <strong>Time Points</strong> reward how fast you flew the speed section. They are
              worth more when many pilots make goal.
            </li>
            <li>
              <strong>Leading Points</strong> (also called "departure points") reward pilots who
              flew at the front and showed the way. On by default; a competition can turn them
              off.
            </li>
            <li>
              <strong>Arrival Points</strong> reward reaching ESS early.
              <strong>Hang gliding only</strong>. On by default for HG; a competition can turn
              them off.
            </li>
          </ul>
          <p class="text-muted-foreground">
            When nobody makes goal, most of the points go to distance. As the goal ratio rises,
            more go to time and leading: if everyone finished, the question is who was fastest,
            not who flew furthest.
          </p>
          <p class="text-muted-foreground">
            A polynomial sets the distance weight from the goal ratio. With nobody in goal,
            distance takes 90% of the points; with half the field in goal, about 42%.
          </p>
          <p class="text-muted-foreground">
            One exception: in <strong>hang gliding</strong>, if nobody reaches the end of the
            speed section, the task has <strong>no time or arrival points at all</strong>.
            Distance and leading keep their usual shares, and the rest simply isn't awarded. No
            pilot's score changes, since nobody could have earned either without crossing ESS,
            but the scoreboard and report card then show what was really on offer. The report
            card says so in its day-quality section and beside the time and arrival components.
          </p>
          <p class="text-muted-foreground">
            That caps such a day. With nobody in goal, the distance weight is 0.9 and the
            <a href="#leading-weight" class="underline hover:text-foreground">leading weight</a>
            is 0.0175, so even a perfect day offers at most <strong>900 points for distance and
            18 for leading, 918 in total</strong>.
          </p>
        </div>
      </section>

      {/* Distance Points */}
      <section id="distance-points" class="mb-14">
        <div class="flex items-baseline justify-between gap-3 flex-wrap mb-4">
          <h2 class="text-2xl font-bold">Distance Points</h2>
          <SpecRef section="12.1" label="FAI S7F §12.1" class="text-xs font-medium text-muted-foreground shrink-0" />
        </div>
        <div class="space-y-4 text-sm leading-relaxed">
          <p class="text-muted-foreground">
            Every pilot who launches earns distance points, which is why they make up most of a
            typical score. In <strong>paragliding</strong>, they are simply proportional to the
            distance you flew:
          </p>
          <p class="bg-muted/50 rounded px-3 py-2 inline-block" set:html={km(String.raw`\text{Distance Points} = \dfrac{\text{Your Distance}}{\text{Best Distance}} \times \text{Available Distance Points}`)}></p>
          <p class="text-muted-foreground">
            The pilot who flew furthest gets all the distance points, and everyone else gets a
            share in proportion. In <strong>hang gliding</strong>, only half the points work this
            way; the other half come from a "difficulty" measure, described below.
          </p>

          <div class="ml-2" id="minimum-distance">
            <h3 class="text-base font-semibold mb-1">Minimum Distance</h3>
            <p class="text-muted-foreground">
              There is a <strong>minimum scored distance</strong>, usually 5 km. Launch and land
              after 1 km, and you're still scored for 5 km. Pilots call these "bomb-out points".
              They give everyone a reason to launch and fly the task rather than stay on the
              ground.
            </p>
            <p class="text-muted-foreground mt-2">
              The one exception is a tracklog that isn't a flight of this task, such as a flight
              on a different day or at a different site. It isn't evidence that the pilot took
              off, so it scores zero, not the minimum, and the page says why. See
              <a href="/scoring/track-validity" class="underline hover:text-foreground">how track validity checks work</a>.
            </p>
          </div>

          <div class="ml-2">
            <h3 id="distance-difficulty" class="flex flex-wrap items-baseline gap-x-2 text-base font-semibold mb-1 scroll-mt-20">
              Distance Difficulty
              <span class="text-sm font-normal text-muted-foreground">
                (hang gliding only)
              </span>
            </h3>
            <p class="text-muted-foreground">
              In hang gliding, distance points come in two halves
              (<SpecRef section="12.1.1" label="S7F §12.1.1" />):
            </p>
            <p class="bg-muted/50 rounded px-3 py-2 inline-block" set:html={km(String.raw`\text{Distance Points} = \left( \tfrac{1}{2}\,\text{Linear} + \tfrac{1}{2}\,\text{Difficulty} \right) \times \text{Available Distance Points}`)}></p>
            <ul class="list-disc list-inside text-muted-foreground space-y-2 ml-2 mt-2">
              <li>
                <strong>The linear half</strong> is the same proportion of the best distance as
                above.
              </li>
              <li>
                <strong>The difficulty half</strong> depends on where the other pilots landed. A
                stretch of the course is "harder" the fewer pilots got past it, so flying past a
                cluster of landed gliders earns more, and gliding a little further into a field
                where everyone else already landed earns less.
              </li>
            </ul>
            <p class="text-muted-foreground mt-2">
              The rulebook gives two reasons. For safety and retrieves, pilots shouldn't be
              tempted to scrape a few extra metres past a group that has landed. And a pilot who
              lands usually struggled just before, so the final glide into a landing field is
              "easy" distance. Pilots who reach goal always get full distance points. The report
              card shows the linear and difficulty halves separately.
            </p>
            <p class="text-muted-foreground mt-2">
              Difficulty does <strong>not</strong> apply to paragliding. A competition can also
              turn it off and score hang gliding with the linear formula alone.
            </p>
          </div>

          <div class="ml-2">
            <h3 id="distance-origin" class="text-base font-semibold mb-1 scroll-mt-20">
              Where distance is measured from
            </h3>
            <p class="text-muted-foreground">
              Some tasks have a separate <strong>take-off</strong> turnpoint before the start
              (SSS), and rulebooks disagree on whether the take-off→start leg counts towards
              scored distance. Each competition picks one of two settings:
            </p>
            <ul class="list-disc list-inside text-muted-foreground space-y-2 ml-2 mt-2">
              <li>
                <strong>Take-off</strong> (default): distance is measured from the take-off
                point, through the start cylinder, to goal. This follows the
                <strong>FAI CIVL GAP</strong> and <strong>PWCA</strong> rules, and matches most
                scoring software, including AirScore.
              </li>
              <li>
                <strong>Start cylinder</strong>: distance is measured from the edge of the start
                cylinder, so the take-off→start leg is <em>not</em> scored. This follows the
                wording of some national hang gliding rules, such as Australia's HGFA/SAFA, and
                matches the "Move Origin" option in the Davis/SeeYou scoring toolchain.
              </li>
            </ul>
            <p class="text-muted-foreground mt-2">
              The two differ by the distance from the route's first point to the edge of the
              start cylinder. With a take-off turnpoint, that's the take-off→start leg. When the
              route begins at the SSS, the FAI rule still measures from the start cylinder's
              centre, so the two differ by the start radius. Neither setting changes the speed
              section (SSS→ESS), so time and leading points are unaffected.
            </p>
          </div>
        </div>
      </section>

      {/* Time Points */}
      <section id="time-points" class="mb-14">
        <div class="flex items-baseline justify-between gap-3 flex-wrap mb-4">
          <h2 class="text-2xl font-bold">Time Points</h2>
          <SpecRef section="12.2" label="FAI S7F §12.2" class="text-xs font-medium text-muted-foreground shrink-0" />
        </div>
        <div class="space-y-4 text-sm leading-relaxed">
          <p class="text-muted-foreground">
            Time points reward pilots who fly the speed section quickly. Who can earn them:
          </p>
          <ul class="list-disc list-inside text-muted-foreground space-y-2 ml-2">
            <li>
              <strong>Paragliding:</strong> you must <strong>make goal</strong>
              (<SpecRef section="13.2" />). This removes any reason for a fast final glide low to
              the ground.
            </li>
            <li>
              <strong>Hang gliding:</strong> you must <strong>reach ESS</strong>, and goal then
              <em>validates</em> your time. By default, a pilot who crosses ESS but lands short of
              goal keeps only <strong>80%</strong> of their time and arrival points
              (<SpecRef section="13.2" />). Each competition can change this under Advanced
              scoring settings. It doesn't affect distance or leading points.
            </li>
          </ul>
          <p class="text-muted-foreground">
            If you qualify, your time points depend on your <strong>speed fraction</strong>, a
            number between 0 and 1 for how close you came to the fastest time:
          </p>
          <p class="bg-muted/50 rounded px-3 py-2 inline-block" set:html={km(String.raw`\text{SF} = \max\!\left(0,\; 1 - \left(\dfrac{\Delta t}{\sqrt{t_{\text{best}}}}\right)^{5/6} \right)`)}></p>
          <p class="text-muted-foreground">
            Here <Fragment set:html={km(String.raw`\Delta t`)} /> is how much slower you were than
            the best time, and <Fragment set:html={km(String.raw`t_{\text{best}}`)} /> is the best
            time, both in hours. The <strong>5/6</strong> exponent is fixed by the 2026
            specification for both sports.
          </p>
          <p class="text-muted-foreground">
            The best time (<SpecRef section="9.4.1" />) is the fastest time of any pilot in goal
            for paragliding, and the fastest time of any pilot to reach ESS for hang gliding,
            whether or not they then made goal.
          </p>
          <p class="text-muted-foreground">
            The curve is forgiving. Pilots close to the fastest time get nearly full points, and
            the drop-off is gradual, so finishing 10 minutes behind the winner still earns a
            large share.
          </p>
          <p class="bg-muted/50 rounded px-3 py-2 inline-block" set:html={km(String.raw`\text{Time Points} = \text{SF} \times \text{Available Time Points}`)}></p>
          <p class="text-muted-foreground">
            In a race with start gates, your clock runs from the <strong>start gate</strong> you
            took (<SpecRef section="9.2.4.1" />): the last gate at or before your start-cylinder
            crossing, not the crossing itself. If the gates are at 13:30 and 13:50 and you cross
            at 13:49, your clock starts at 13:30.
          </p>
          <p class="text-muted-foreground">
            A time trial uses your actual crossing time. Either way, the report card shows the
            gate you took and when you crossed.
          </p>
          <div id="elevated-goal" class="scroll-mt-20">
            <h3 class="text-base font-semibold mb-1">Elevated goal (<SpecRef section="6.2.3.2" />, <SpecRef section="13.1" />)</h3>
            <p class="text-muted-foreground">
              A task can set goal at a height above the goal turnpoint's altitude: 300 m as
              standard, 1000 m at most. The task file gives it in XCTrack's
              <code>finishAltitude</code> field, and an elevated goal is also the end of the speed
              section. Crossing at any altitude still reaches goal, but crossing below the set
              height costs you some of your time points. Your other points are unaffected.
            </p>
            <p class="bg-muted/50 rounded px-3 py-2 inline-block" set:html={km(String.raw`\text{AR} = \frac{\text{crossing altitude} - \text{goal altitude}}{\text{elevation}}`)}></p>
            <p class="bg-muted/50 rounded px-3 py-2 inline-block" set:html={km(String.raw`\text{GoalAltitudeFactor} = 0.8 + 0.6\,\text{AR} - 0.6\,\text{AR}^2 + 0.2\,\text{AR}^3`)}></p>
            <p class="text-muted-foreground">
              The factor is 0.8 at or below the goal turnpoint's altitude and 1 at or above the
              set height, and your time points are multiplied by it. For example, crossing 60 m
              above goal under a 300 m elevated goal gives an AR of 0.2, and you keep about 90%
              of your time points. GlideComp applies an elevated goal only when the goal
              turnpoint has an altitude, since otherwise there's nothing to measure the height
              from.
            </p>
          </div>
        </div>
      </section>

      {/* Leading Points */}
      <section id="leading-points" class="mb-14">
        <div class="flex items-baseline justify-between gap-3 flex-wrap mb-4">
          <h2 class="text-2xl font-bold">Leading Points</h2>
          <SpecRef section="12.3" label="FAI S7F §12.3" class="text-xs font-medium text-muted-foreground shrink-0" />
        </div>
        <div class="space-y-4 text-sm leading-relaxed">
          <p class="text-muted-foreground">
            Leading points, also called "departure points", reward pilots who take the risk of
            flying at the front of the gaggle and showing the way to goal. Without them, the
            best tactic would be to hang back in thermals and let others find the way.
          </p>

          <div class="ml-2 space-y-4">
            <div>
              <h3 id="leading-coefficient" class="text-base font-semibold mb-1 scroll-mt-20">
                The Leading Coefficient
              </h3>
              <p class="text-muted-foreground">
                Each pilot gets a <strong>leading coefficient (LC)</strong>, which measures how
                much time they spent near the front and close to ESS. It is the area under a
                curve of remaining distance to ESS over time, with distance measured along the
                course and time from when the first start gate opens.
              </p>
              <p class="text-muted-foreground">
                A "ratchet" keeps your best progress: the distance only ever decreases as you get
                closer to ESS, so flying away from ESS never undoes progress you've made. This is
                the same leading coefficient CIVL GAP and AirScore use.
              </p>
              <p class="text-muted-foreground">
                The 2026 specification defines a different LC for each sport
                (<SpecRef section="12.3.1" />). <strong>Hang gliding</strong> uses the
                <em>classic</em> squared-distance area. <strong>Paragliding</strong> uses a
                <em>weighted</em> area in which the middle of the course counts for more, computed
                as the specification's exact weight-envelope integral since the 2025 edition.
                Each sport gets its own variant; it isn't a setting. The report card names the
                variant used.
              </p>
              <p class="text-muted-foreground">
                A <strong>lower</strong> LC means you spent more time at the front. The pilot
                with the lowest LC gets full leading points.
              </p>
            </div>
            <div>
              <h3 id="leading-max-time" class="text-base font-semibold mb-1 scroll-mt-20">
                Pilots who land out
              </h3>
              <p class="text-muted-foreground">
                A pilot who lands before ESS has no more track to measure, but their curve still
                has to cover the rest of the day. GlideComp holds them at the best distance they
                reached and extends the curve to <em>maxTime</em>
                (<SpecRef section="12.3.1" />):
              </p>
              <p class="bg-muted/50 rounded px-3 py-2 inline-block" set:html={km(String.raw`\text{maxTime} = \min\!\left(\max(\text{lastOutlandingTime},\; \text{lastESSTime}),\; \text{taskDeadline}\right)`)}></p>
              <p class="text-muted-foreground">
                That is, whichever came later, the last pilot landing out or the last pilot
                reaching ESS, but never after the task deadline. In a stopped task, the curve ends
                at the task stop time, because nothing after the stop is scored.
              </p>
              <p class="text-muted-foreground">
                maxTime is the same for the whole class, not set per pilot. So a pilot who stays
                up long after the winner is home adds a little to the leading coefficient of
                everyone who landed out. Your report card shows the maxTime your curve used and
                what set it.
              </p>
            </div>
            <div>
              <h3 class="text-base font-semibold mb-1">How Points Are Awarded</h3>
              <p class="text-muted-foreground">
                Leading points follow a curve shaped like the time-points curve, using LC values
                in place of times:
              </p>
              <p class="bg-muted/50 rounded px-3 py-2 inline-block" set:html={km(String.raw`\text{LF} = \max\!\left(0,\; 1 - \left(\dfrac{\text{LC} - \text{LC}_{\min}}{\sqrt{\text{LC}_{\min}}}\right)^{2/3} \right)`)}></p>
              <p class="text-muted-foreground">
                The pilot with the best (lowest) LC gets full leading points, and everyone else
                gets less the further their LC is from the best.
              </p>
            </div>
          </div>

          <p class="text-muted-foreground">
            Leading points are <strong>on by default</strong> for both sports, as in the FAI
            formula, and a competition can turn them off. Paragliding gives leading more weight
            than hang gliding, because it has no arrival points competing for the non-distance
            share.
          </p>

          <div>
            <h3 id="leading-weight" class="text-base font-semibold mb-1 scroll-mt-20">
              How much weight goes to leading
            </h3>
            <p class="text-muted-foreground">
              The 2026 specification uses one formula for both sports (<SpecRef section="11" />):
              leading gets the task's <em>Leading&nbsp;Time&nbsp;Ratio</em> of the non-distance
              weight. The ratio can be set anywhere from 0% to 26%; the default is 26% for
              paragliding and 17.5% for hang gliding.
            </p>
            <p class="bg-muted/50 rounded px-3 py-2 inline-block" set:html={km(String.raw`\text{LeadingWeight} = (1 - \text{DistanceWeight}) \times \text{LeadingTimeRatio}`)}></p>
            <p class="text-muted-foreground">
              <strong>Paragliding</strong> has one extra rule: if nobody makes goal, leading gets
              <strong>all</strong> of the non-distance weight, since no one can earn time points
              without goal. <strong>Hang gliding</strong> has no such rule. With nobody in goal
              the distance weight is 0.9, so leading at the default ratio gets 0.0175: the 18
              points of the
              <a href="#scoring-components" class="underline hover:text-foreground">918-point ceiling</a>
              above.
            </p>
            <p class="text-muted-foreground">
              Earlier editions let paragliding competitions choose between three generations of
              leading weight. GlideComp scores every task, historical competitions included, with
              the 2026 formula, and each scores page names the edition it was scored under (see
              <a href="#spec-differences" class="underline hover:text-foreground">Differences from the Official Specification</a>).
            </p>
          </div>
        </div>
      </section>

      {/* Arrival Points */}
      <section id="arrival-points" class="mb-14">
        <div class="flex items-baseline justify-between gap-3 flex-wrap mb-4">
          <h2 class="text-2xl font-bold">Arrival Points</h2>
          <SpecRef section="12.4" label="FAI S7F §12.4" class="text-xs font-medium text-muted-foreground shrink-0" />
        </div>
        <div class="space-y-4 text-sm leading-relaxed">
          <p class="text-muted-foreground">
            <strong>Hang gliding only.</strong> Arrival points reward the order in which pilots
            reach ESS. The first to arrive gets the most, and each later pilot gets less.
          </p>
          <p class="text-muted-foreground">
            <strong>Except Class 2.</strong> A hang gliding class flying FAI Class 2 (rigid wings
            with movable aerodynamic surfaces) gets no arrival points: its arrival weight is 0,
            and that share goes to time (<SpecRef section="11" label="§11" />). The organiser
            marks which classes fly Class 2 in the competition's scoring settings.
          </p>
          <p class="text-muted-foreground">
            <strong>The order comes from the clock at ESS, not from speed.</strong> Pilots are
            ranked by the time of day they crossed the end of the speed section. So a pilot on an
            earlier start gate can arrive ahead of a faster pilot on a later gate and earn more
            arrival points. That surprises people, but it's intended: arrival points reward
            <em>getting there first</em>, which is what makes racing at the front worth the risk.
            Time points already reward speed.
          </p>
          <p class="text-muted-foreground">
            The first pilot to arrive gets 100% of the available arrival points, and everyone who
            reaches ESS gets at least about 20% (the constant term in the curve below). In
            between, the curve falls quickly at first: arriving ahead of half the field is worth
            about <strong>33%</strong>, not 50%.
          </p>
          <p class="text-muted-foreground">
            Here <em>ArrivalRatio</em> is the fraction of the pilots reaching ESS that you arrived
            ahead of:
          </p>
          <p class="bg-muted/50 rounded px-3 py-2 inline-block" set:html={km(String.raw`\text{ArrivalRatio} = 1 - \frac{\text{PositionAtESS} - 1}{\text{PilotsAtESS}}`)}></p>
          <p class="bg-muted/50 rounded px-3 py-2 inline-block" set:html={km(String.raw`\text{ArrivalFactor} = 0.2 + 0.037\,r + 0.13\,r^2 + 0.633\,r^3`)}></p>
          <p class="text-muted-foreground">
            The four coefficients add up to exactly 1, so the first arrival gets the full
            points. Each pilot's report card shows their position, ESS time and the arithmetic,
            and the <strong>ESS</strong> column of the task's scores table shows the arrival
            order for the whole field.
          </p>
          <p class="text-muted-foreground">
            Arrival points are <strong>on by default</strong> for hang gliding, and a competition
            can turn them off. They never apply to paragliding.
          </p>
        </div>
      </section>

      {/* Your Total Score */}
      <section id="total-score" class="mb-14">
        <div class="flex items-baseline justify-between gap-3 flex-wrap mb-4">
          <h2 class="text-2xl font-bold">Your Total Score</h2>
          <SpecRef section="12" label="FAI S7F §12" class="text-xs font-medium text-muted-foreground shrink-0" />
        </div>
        <div class="space-y-4 text-sm leading-relaxed">
          <p class="text-muted-foreground">
            Your task score is the sum of your four components, rounded to <strong>one decimal
            place</strong> (<SpecRef section="12" label="S7F §12" />). Penalties are subtracted
            <em>before</em> rounding (<SpecRef section="13.5" />), so rounding is always the last
            step:
          </p>
          <p class="bg-muted/50 rounded px-3 py-2 inline-block" set:html={km(String.raw`\text{Total} = \text{round}_{0.1}\!\left(\text{Distance} + \text{Time} + \text{Leading} + \text{Arrival} - \text{Penalties}\right)`)}></p>
          <p class="text-muted-foreground">
            A score never goes below zero, however large the penalty. Pilots are ranked by total,
            highest first, and a tie goes to the pilot who flew further. The scoreboard shows
            whole points, but ranking and tie-breaks use the one-decimal value.
          </p>

          <div class="ml-2">
            <h3 class="text-base font-semibold mb-1">Practical Example</h3>
            <p class="text-muted-foreground">
              Take a paragliding task on a good day: task validity 0.95, 20% of pilots in goal,
              and leading points turned off. The task offers 950 points, split roughly like
              this:
            </p>
            <ul class="list-disc list-inside text-muted-foreground space-y-1 ml-2">
              <li>Distance: ~600 points (63% weight)</li>
              <li>Time: ~350 points (37% weight)</li>
            </ul>
            <p class="text-muted-foreground mt-2">
              The fastest pilot in goal scores 600 + 350 = 950. A pilot who flew 80% of the best
              distance but didn't make goal scores about 480 + 0 = 480, because in paragliding
              there are no time points without goal.
            </p>
          </div>
        </div>
      </section>

      {/* Stopped Tasks */}
      <section id="stopped-tasks" class="mb-14 scroll-mt-20">
        <div class="flex items-baseline justify-between gap-3 flex-wrap mb-4">
          <h2 class="text-2xl font-bold">Stopped Tasks</h2>
          <SpecRef section="13.4" label="FAI S7F §13.4" class="text-xs font-medium text-muted-foreground shrink-0" />
        </div>
        <div class="space-y-4 text-sm leading-relaxed">
          <p class="text-muted-foreground">
            If the weather turns, the safety committee can stop a task mid-flight. The organiser
            records when the stop was announced, and GlideComp applies the specification's
            stopped-task rules automatically. Each affected pilot's report card shows how.
          </p>

          <div class="ml-2 space-y-4">
            <div>
              <h3 class="text-base font-semibold mb-1">The task stop time (<SpecRef section="13.4.1" />)</h3>
              <p class="text-muted-foreground">
                So that nobody close to a scoring milestone has a reason to keep flying in
                dangerous conditions, the task is scored back to a <strong>task stop
                time</strong> before the announcement: 15 minutes earlier for hang gliding, 5
                minutes for paragliding. Both are fixed by the specification.
              </p>
            </div>
            <div>
              <h3 class="text-base font-semibold mb-1">Can the task be scored at all? (<SpecRef section="13.4.2" />)</h3>
              <p class="text-muted-foreground">
                In <strong>hang gliding</strong>, a stopped task counts only if it ran long
                enough: at least <strong>min(1 hour, half the nominal time)</strong>, measured
                from the race start with one start gate, or from the last start any pilot took
                with several gates or in a time trial. A task stopped sooner scores zero for
                everyone, and the scores say why.
              </p>
              <p class="text-muted-foreground mt-2">
                <strong>Paragliding</strong> has no minimum. Instead, a stopped task whose winner
                scored under 50 points (task validity below 0.05) is left out of the competition
                total (<SpecRef section="15" label="§15" />). It still shows on its own scores
                page.
              </p>
            </div>
            <div>
              <h3 class="text-base font-semibold mb-1">Stopped-task validity (<SpecRef section="13.4.3" />)</h3>
              <p class="text-muted-foreground">
                A fourth validity joins launch, distance and time. If anyone reached the end of
                the speed section, it is 1, because the race had a result. If nobody did, it
                lowers the day's value depending on how spread out the field was and how many
                pilots had already landed at the stop.
              </p>
            </div>
            <div>
              <h3 class="text-base font-semibold mb-1">What part of your flight counts (<SpecRef section="13.4.4" />)</h3>
              <p class="text-muted-foreground">
                Nobody earns points for flying after the task stop time. In a race with one start
                gate, every pilot is scored from the start to the stop time. With several gates,
                or in a time trial, everyone gets the same amount of flying time: as much as the
                last pilot to start had before the stop, counted from each pilot's own start. A
                turnpoint tagged after your window doesn't count, and your distance is measured
                only up to the end of it.
              </p>
            </div>
            <div>
              <h3 class="text-base font-semibold mb-1">Time points (<SpecRef section="13.4.5" />)</h3>
              <p class="text-muted-foreground">
                If nobody was in goal at the stop, the task has no time points. If someone was,
                every goal pilot's time points are reduced by the same amount, and that amount is
                added to the distance points on offer instead. The amount is the time points the
                best of the pilots still between ESS and goal would have earned had they made
                goal. If nobody was between ESS and goal, it is what a pilot reaching ESS exactly
                at the stop would have earned.
              </p>
            </div>
            <div>
              <h3 class="text-base font-semibold mb-1">The altitude bonus (<SpecRef section="13.4.6" />)</h3>
              <p class="text-muted-foreground">
                A pilot still in the air at the stop could have turned their height into more
                distance, so they get an <strong>altitude bonus</strong>. Their height above goal
                at the stop time is multiplied by a fixed glide ratio, <strong>5:1 for hang
                gliders and 2.5:1 for paragliders</strong> (on GNSS altitude), and added to the
                distance they had covered at that moment. If the result beats their best distance
                so far, it is used for their distance points, including the difficulty
                calculation in hang gliding.
              </p>
              <p class="text-muted-foreground mt-2">
                The bonus never takes a pilot past goal, and it doesn't affect time or leading
                points. A pilot who landed before the stop gets no bonus.
              </p>
            </div>
          </div>

          <p class="text-muted-foreground">
            The task page marks a stopped task and shows its stop time, and the competition's
            public audit log records the stop. Each pilot's report card shows their scored
            window, any crossings that no longer counted, their altitude bonus, and any reduction
            to their time points.
          </p>
        </div>
      </section>

      {/* Fixed Total Validity (FTV) */}
      <section id="ftv" class="mb-14 scroll-mt-20">
        <div class="flex items-baseline justify-between gap-3 flex-wrap mb-4">
          <h2 class="text-2xl font-bold">Series scoring &amp; Fixed Total Validity</h2>
          <SpecRef section="15" label="FAI S7F §15–16" class="text-xs font-medium text-muted-foreground shrink-0" />
        </div>
        <div class="space-y-4 text-sm leading-relaxed">
          <p class="text-muted-foreground">
            A competition's overall results combine each pilot's task scores. There are two ways
            to do it, and each competition picks one in its scoring settings.
          </p>

          <div class="ml-2 space-y-4">
            <div>
              <h3 class="text-base font-semibold mb-1">Sum of task scores</h3>
              <p class="text-muted-foreground">
                Your competition score is the total of all your task scores. Most hang gliding
                competitions and short series work this way. Pilots on the same total share a
                place, which
                <a href={S7A_PDF} target="_blank" rel="noopener noreferrer" class="underline hover:text-foreground">S7A §5.2.5.4</a>
                allows.
              </p>
            </div>
            <div>
              <h3 class="text-base font-semibold mb-1">FTV — Fixed Total Validity (<SpecRef section="16" label="§16" />)</h3>
              <p class="text-muted-foreground">
                The usual paragliding method, and the default for new paragliding competitions.
                FTV counts your <strong>best</strong> tasks rather than all of them, so one bad
                day costs you less. A fixed fraction of the competition's total validity is
                dropped: <strong>20%</strong> for a competition of 6 tasks or fewer,
                <strong>25%</strong> for 7 or more.
              </p>
              <p class="text-muted-foreground mt-2">
                Each task has a <em>validity</em>, roughly its winning score divided by 1000.
                GlideComp sorts your tasks from your best performance down, then adds up your
                scores, and the tasks' validities, until the kept validity reaches the limit. The
                task that crosses the limit counts <strong>in part</strong>, and the tasks after it
                are <strong>dropped</strong>. A pilot who flew too few tasks to reach the limit
                keeps them all.
              </p>
              <p class="text-muted-foreground mt-2">
                On an FTV competition's scores page, each pilot's dropped tasks are struck
                through, and "(part)" marks a task that counts in part. Open a pilot's total for
                the full breakdown: which tasks counted, which were dropped, and the arithmetic.
              </p>
            </div>
          </div>
        </div>
      </section>

      {/* Default Competition Settings */}
      <section id="defaults" class="mb-14 scroll-mt-20">
        <div class="flex items-baseline justify-between gap-3 flex-wrap mb-4">
          <h2 class="text-2xl font-bold">Default Competition Settings</h2>
          <SpecRef section="5" label="FAI S7F §5" class="text-xs font-medium text-muted-foreground shrink-0" />
        </div>
        <div class="space-y-4 text-sm leading-relaxed">
          <p class="text-muted-foreground">
            When you create a competition, you only choose <strong>hang gliding</strong> or
            <strong>paragliding</strong>. GlideComp then applies the official CIVL GAP defaults
            for that sport, taken from the current FAI Sporting Code Section 7F, so a new
            competition scores like a standard FAI/AirScore event with no further setup. You can
            change any default under <em>Advanced scoring settings</em> in the competition's
            Settings, which you'd only need to do if your event runs local rules with different
            values, such as Australia's SAFA.
          </p>

          <p class="text-muted-foreground">
            Most values are the same for both sports. Where they differ, it's because the
            specification scores the two differently: arrival points and distance difficulty
            are hang gliding only, and paragliding gives leading more weight because it has no
            arrival points.
          </p>

          <div class="overflow-x-auto">
            <table class="w-full text-sm border-collapse">
              <thead>
                <tr class="border-b border-border">
                  <th class="text-left py-2 pr-4 font-semibold">Setting</th>
                  <th class="text-left py-2 pr-4 font-semibold">Default</th>
                  <th class="text-left py-2 font-semibold">What it means</th>
                </tr>
              </thead>
              <tbody class="text-muted-foreground align-top">
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-4">Nominal distance</td>
                  <td class="py-2 pr-4 whitespace-nowrap">Auto</td>
                  <td class="py-2">The expected task distance, used for distance validity. "Auto" uses 70% of each task's optimised distance; a fixed value applies to every task in the competition.</td>
                </tr>
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-4">Nominal time</td>
                  <td class="py-2 pr-4 whitespace-nowrap">90 min</td>
                  <td class="py-2">The expected winning time. A much faster winner makes the task worth less (time validity).</td>
                </tr>
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-4">Minimum distance</td>
                  <td class="py-2 pr-4 whitespace-nowrap">5 km</td>
                  <td class="py-2">The distance a pilot who launched is scored for, even if they land sooner ("bomb-out points").</td>
                </tr>
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-4">
                    <a href="#leading-points" class="underline hover:text-foreground">Leading points</a>
                  </td>
                  <td class="py-2 pr-4 whitespace-nowrap">On</td>
                  <td class="py-2">Reward flying at the front. On for both sports, as in the FAI formula.</td>
                </tr>
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-4">
                    <a href="#leading-weight" class="underline hover:text-foreground">Leading time ratio</a>
                  </td>
                  <td class="py-2 pr-4 whitespace-nowrap">26% / 17.5%</td>
                  <td class="py-2">The share of the non-distance weight that goes to leading points (<SpecRef section="11" label="§11" />), from 0% to 26%. The defaults are the specification's: 26% for paragliding, 17.5% for hang gliding.</td>
                </tr>
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-4">
                    <a href="#distance-origin" class="underline hover:text-foreground">Distance origin</a>
                  </td>
                  <td class="py-2 pr-4 whitespace-nowrap">Take-off</td>
                  <td class="py-2">Scored distance is measured from the take-off point, through the start (FAI CIVL GAP / PWCA). "Start cylinder" leaves out the take-off→start leg (HGFA/SAFA).</td>
                </tr>
              </tbody>
            </table>
          </div>

          <p class="text-muted-foreground">
            A few values that used to be settings are now fixed by the 2026 specification:
            nominal launch (96%), nominal goal (30%), the stopped-task score-back time, the 5/6
            time-points exponent, and each sport's leading-coefficient variant.
          </p>

          <div id="defaults-hg" class="ml-2 scroll-mt-20">
            <h3 class="text-base font-semibold mb-1">Hang gliding (HG)</h3>
            <ul class="list-disc list-inside text-muted-foreground space-y-1 ml-2">
              <li><a href="#arrival-points" class="underline hover:text-foreground">Arrival points</a>: <strong>on</strong>. HG scores the order of arrival at ESS (<SpecRef section="12.4" label="§12.4" />).</li>
              <li><a href="#distance-difficulty" class="underline hover:text-foreground">Distance difficulty</a>: <strong>on</strong>. HG distance points are half linear, half difficulty (<SpecRef section="12.1.1" label="§12.1.1" />).</li>
              <li><a href="#leading-points" class="underline hover:text-foreground">Leading coefficient</a>: <strong>classic</strong> (squared-distance), the 2026 specification's hang gliding formula (<SpecRef section="12.3.1" label="§12.3.1" />).</li>
              <li>Jump-the-gun (early start, <SpecRef section="13.3" label="§13.3" />): 1 penalty point for every <strong>2 s</strong> before the gate, up to <strong>300 s</strong>. A pilot who starts more than 300 s early is scored for minimum distance only.</li>
              <li>ESS but not goal (<SpecRef section="13.2" label="§13.2" />): the pilot keeps <strong>80%</strong> of their time and arrival points. This is the specification's recommended default, and local rules can change it.</li>
            </ul>
          </div>

          <div id="defaults-pg" class="ml-2 scroll-mt-20">
            <h3 class="text-base font-semibold mb-1">Paragliding (PG)</h3>
            <ul class="list-disc list-inside text-muted-foreground space-y-1 ml-2">
              <li><a href="#arrival-points" class="underline hover:text-foreground">Arrival points</a>: <strong>off</strong>. The specification gives paragliding none.</li>
              <li><a href="#distance-difficulty" class="underline hover:text-foreground">Distance difficulty</a>: <strong>off</strong>. Paragliding distance is always the linear proportion.</li>
              <li><a href="#leading-points" class="underline hover:text-foreground">Leading coefficient</a>: <strong>weighted</strong> (weighted-area), the 2026 specification's paragliding formula (<SpecRef section="12.3.1" label="§12.3.1" />).</li>
              <li>Early start (<SpecRef section="13.3" label="§13.3" />): scored for the launch→start distance only. There is no jump-the-gun penalty, which is for HG only.</li>
              <li>ESS but not goal (<SpecRef section="13.2" label="§13.2" />): <strong>0%</strong>, so no time points without goal. The specification fixes this for paragliding, to discourage fast final glides low to the ground.</li>
            </ul>
          </div>
        </div>
      </section>

      {/* GlideComp Implementation Notes */}
      <section id="glidecomp-notes" class="mb-14">
        <h2 class="text-2xl font-bold mb-4">GlideComp Implementation Notes</h2>
        <div class="space-y-4 text-sm leading-relaxed">
          <p class="text-muted-foreground">
            GlideComp implements the core GAP formulas of the 2026 edition of the CIVL Sporting
            Code Section 7F, and scores every task with them, including historical competitions
            flown under earlier rules (those pages carry a notice that their scores are
            indicative). We check its results against real competition scores published by
            AirScore. The validity polynomials, weight split and points formulas follow the
            official specification. GlideComp doesn't implement every feature of the
            specification, and in a few places it deliberately, or for now, behaves differently;
            the <a href="#spec-differences" class="underline hover:text-foreground">next section</a>
            lists every difference.
          </p>

          <p class="text-muted-foreground">
            The tables below group features by <strong class="text-foreground">FAI competition
            category</strong>. Section 7F is written for <strong>Category 1</strong> events, the
            FAI World and Continental championships. Organisers of <strong>Category 2</strong>
            and non-sanctioned events, which includes most local and club competitions, may score
            however they like (<SpecRef section="1.1" label="S7F §1.1" />). GlideComp has
            everything a Category 2 or local competition needs; all it lacks are the Category 1
            championship sub-rankings.
          </p>

          <h3 class="text-base font-semibold mt-6 mb-2">All competition categories</h3>
          <div class="overflow-x-auto">
            <table class="w-full text-sm border-collapse">
              <thead>
                <tr class="border-b border-border">
                  <th class="text-left py-2 pr-4 font-semibold">Feature</th>
                  <th class="text-left py-2 font-semibold">Status</th>
                </tr>
              </thead>
              <tbody class="text-muted-foreground">
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-4">Task validity (launch, distance, time)</td>
                  <td class="py-2">Implemented</td>
                </tr>
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-4">Distance, time, leading, arrival points</td>
                  <td class="py-2">Implemented</td>
                </tr>
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-4">Weight distribution</td>
                  <td class="py-2">Implemented</td>
                </tr>
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-4">PG and HG scoring differences</td>
                  <td class="py-2">Implemented</td>
                </tr>
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-4">Leading coefficient (ratchet mechanism)</td>
                  <td class="py-2">Implemented</td>
                </tr>
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-4">Minimum distance floor</td>
                  <td class="py-2">Implemented</td>
                </tr>
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-4">Penalties — absolute points (<SpecRef section="13.5" label="S7F §13.5" />)</td>
                  <td class="py-2">Implemented. Entered by the scorekeeper and recorded in the audit log.</td>
                </tr>
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-4">Penalties — percentage (<SpecRef section="13.5" />)</td>
                  <td class="py-2">Not implemented. Tracked in <a href="https://github.com/pokle/glidecomp/issues/265" target="_blank" rel="noopener noreferrer" class="underline hover:text-foreground">issue #265</a>; add your voice there if you need it.</td>
                </tr>
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-4">Early starts &amp; jump-the-gun (<SpecRef section="13.3" />)</td>
                  <td class="py-2">Implemented. PG is scored launch→start. HG gets 1 point for every X s early, up to Y s, where X and Y are configurable (defaults 2 and 300).</td>
                </tr>
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-4">ESS but not goal (<SpecRef section="13.2" />)</td>
                  <td class="py-2">Implemented. PG keeps 0% of time points. HG keeps 80% of time and arrival points, configurable.</td>
                </tr>
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-4">Start gates / race start times (<SpecRef section="6.3.1" />, <SpecRef section="9.2.4.1" />)</td>
                  <td class="py-2">Implemented. The start snaps to the last gate at or before the crossing. The LC clock runs from the first gate (<SpecRef section="12.3.1" />).</td>
                </tr>
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-4">Goal lines (<SpecRef section="6.2.3.1" />, <SpecRef section="9.2.3" />)</td>
                  <td class="py-2">Implemented. The line is perpendicular to the final leg, with the control semi-circle behind it, and must be crossed in the direction of the last leg.</td>
                </tr>
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-4">Line tolerance (<SpecRef section="9.1.2" />)</td>
                  <td class="py-2">Implemented for the goal line: the same 5&nbsp;m band as a cylinder, so a crossing just past the end of the line still counts.</td>
                </tr>
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-4">Line control zones at intermediate turnpoints (<SpecRef section="6.2.2" />, <SpecRef section="9.2.2" />)</td>
                  <td class="py-2">Not implemented. Every turnpoint before goal is a cylinder; the task file can't describe a line anywhere but goal, so no task can ask for one. Tracked in <a href="https://github.com/pokle/glidecomp/issues/359" target="_blank" rel="noopener noreferrer" class="underline hover:text-foreground">issue #359</a>.</td>
                </tr>
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-4">Open distance task type</td>
                  <td class="py-2">Removed from GAP in the 2025 edition, which covers only Race and Time Trial tasks. GlideComp's <a href="/scoring/open-distance" class="underline hover:text-foreground">open-distance format</a> is the classic free-flight format, a separate scoring format outside GAP.</td>
                </tr>
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-4">Task deadline enforcement (<SpecRef section="9.2" />, <SpecRef section="12.1" />)</td>
                  <td class="py-2">Implemented. A crossing after the goal deadline doesn't count, and a landed-out pilot's distance is measured only up to the deadline.</td>
                </tr>
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-4">Launch window (<SpecRef section="9.3" />)</td>
                  <td class="py-2">Partly implemented. A start crossing before the window opens can't validate a start. See below.</td>
                </tr>
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-4">Stopped tasks (weather calldowns, <SpecRef section="13.4" />)</td>
                  <td class="py-2">Implemented: score-back, minimum duration, stopped validity, scored time window, time-points reduction and altitude bonus. See <a href="#stopped-tasks" class="underline hover:text-foreground">Stopped Tasks</a>.</td>
                </tr>
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-4">Multi-task series scoring</td>
                  <td class="py-2">Implemented. Competition totals per class, with top 3 per task and team scores. See the <a href="/comp" class="underline hover:text-foreground">competition scores pages</a>.</td>
                </tr>
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-4">FTV (fixed total validity) for series</td>
                  <td class="py-2">Implemented as an optional series method, and the default for new paragliding competitions. It drops a fixed fraction of the total validity (20% for 6 tasks or fewer, 25% for 7 or more) and scores each pilot on their best tasks. See <a href="#ftv" class="underline hover:text-foreground">Fixed Total Validity</a>.</td>
                </tr>
              </tbody>
            </table>
          </div>

          <h3 class="text-base font-semibold mt-8 mb-2">FAI Category 1 (World &amp; Continental championships) only</h3>
          <p class="text-muted-foreground">
            These sub-rankings only appear at FAI Category 1 championships, which have national
            team entries and a separate women's category. GlideComp
            <strong class="text-foreground">deliberately leaves them out</strong>: Category 2 and
            local competitions don't use them, they're defined in Sporting Code
            <a href={S7A_PDF} target="_blank" rel="noopener noreferrer" class="underline hover:text-foreground">Section 7A</a>
            §5.2.4–5.2.5, and they don't change anyone's score, since each is just a filtered list
            of the same task scores.
          </p>
          <div class="overflow-x-auto">
            <table class="w-full text-sm border-collapse">
              <thead>
                <tr class="border-b border-border">
                  <th class="text-left py-2 pr-4 font-semibold">Feature</th>
                  <th class="text-left py-2 font-semibold">Status</th>
                </tr>
              </thead>
              <tbody class="text-muted-foreground">
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-4">Female sub-ranking (S7A §5.2.4.2, §5.2.5.2)</td>
                  <td class="py-2">Deliberately not implemented. It re-lists the female pilots with their overall scores, and needs gender data GlideComp doesn't collect.</td>
                </tr>
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-4">Nation sub-ranking / national teams (S7A §5.2.4.3, §5.2.5.3)</td>
                  <td class="py-2">Deliberately not implemented. It ranks nations by the sum of their best three pilots (two at the Women's Worlds), and needs national-team entries. It's not the same as GlideComp's <a href="/comp" class="underline hover:text-foreground">team scores</a>, which any competition can use.</td>
                </tr>
              </tbody>
            </table>
          </div>

          <p class="text-muted-foreground">
            A new competition starts with the official CIVL GAP settings for its sport: leading
            points on for both, and arrival points and distance difficulty on for hang gliding,
            so its scores match a standard FAI/AirScore event. See
            <a href="#defaults" class="underline hover:text-foreground">Default Competition Settings</a>
            for the full list. You can change any of them under the competition's Advanced
            scoring settings.
          </p>
          <p class="text-muted-foreground">
            The scoring engine is open source on
            <a href="https://github.com/pokle/glidecomp" target="_blank" rel="noopener noreferrer" class="underline hover:text-foreground">GitHub</a>.
            Every change to how a flight is scored is written up in the
            <a href="https://github.com/pokle/glidecomp/tree/master/web/engine/scoring-changes" target="_blank" rel="noopener noreferrer" class="underline hover:text-foreground">scoring changelog</a>,
            with what moved and who it affects. A change rescores every competition, including
            ones that have already finished.
          </p>
        </div>
      </section>

      {/* Differences from the Official Specification */}
      <section id="spec-differences" class="mb-14 scroll-mt-20">
        <h2 class="text-2xl font-bold mb-4">Differences from the Official Specification</h2>
        <div class="space-y-4 text-sm leading-relaxed">
          <p class="text-muted-foreground">
            We compared GlideComp's scoring engine line by line with FAI Sporting Code Section 7F
            (2026 edition) and with the source code of
            <a href="https://github.com/biuti/airscore-app" target="_blank" rel="noopener noreferrer" class="underline hover:text-foreground">AirScore</a>,
            the CIVL-approved scoring software, most recently in August 2026. The table compares
            the three on each part of the formula, and the notes below it explain the notable
            differences. Section numbers (§) refer to the 2026 edition and link to the right page
            of the <SpecRef section="0" label="official PDF" />.
          </p>
          <p class="text-muted-foreground">
            The AirScore column describes its current GAP presets, which are GAP2023 unless
            another generation is named. AirScore's older generations behave differently where
            the table says so.
          </p>

          <div class="overflow-x-auto">
            <table class="w-full text-sm border-collapse">
              <thead>
                <tr class="border-b border-border">
                  <th class="text-left py-2 pr-3 font-semibold">Feature</th>
                  <th class="text-left py-2 pr-3 font-semibold">FAI S7F (2026)</th>
                  <th class="text-left py-2 pr-3 font-semibold">GlideComp</th>
                  <th class="text-left py-2 font-semibold">AirScore</th>
                </tr>
              </thead>
              <tbody class="text-muted-foreground align-top">
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-3">Task validity (<SpecRef section="10" />)</td>
                  <td class="py-2 pr-3">Launch, distance and time validity from the specification's cubic polynomials.</td>
                  <td class="py-2 pr-3">As the specification.</td>
                  <td class="py-2">As the specification in GAP2020 and later. Editions before 2025 printed the launch-validity linear coefficient as 0.027; the 2025 edition corrected that decade-old typo to 0.028, which AirScore's library always used, so all three now agree.</td>
                </tr>
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-3">Weight split — hang gliding (<SpecRef section="11" />)</td>
                  <td class="py-2 pr-3">DistW = 0.9 − 1.665·GR + 1.713·GR² − 0.587·GR³. Arrival is (1−DistW)/8. Leading is 1.4·(1−DistW)/8 at the default ratio.</td>
                  <td class="py-2 pr-3">As the specification.</td>
                  <td class="py-2">As the specification, and the same in every generation.</td>
                </tr>
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-3">Weight split — paragliding (<SpecRef section="11" />)</td>
                  <td class="py-2 pr-3">Leading gets <em>LeadingTimeRatio</em> (default 26%) of the non-distance weight, or <strong>all</strong> of it when nobody makes goal.</td>
                  <td class="py-2 pr-3">As the specification, for every task. The pre-2026 leading-weight generations (GAP2016/2018, the PWC weights of 2020–2022) are no longer implemented; historical competitions are rescored with the 2026 formula and their pages say so.</td>
                  <td class="py-2">The gap2023 preset is the specification. The gap2020, gap2021 and gap2022 presets use the PWC-derived S7F 2020–2022 weights: distance 0.838 at 0% goal, otherwise 0.805 − 1.374·GR + 1.413·GR² − 0.484·GR³, with leading fixed at 0.162.</td>
                </tr>
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-3">Time-points curve (<SpecRef section="12.2" />)</td>
                  <td class="py-2 pr-3">SF = 1 − (Δt/√t<sub>best</sub>)<sup>5/6</sup>, both sports.</td>
                  <td class="py-2 pr-3">5/6 for every task. The older 2/3 curve is no longer implemented.</td>
                  <td class="py-2">5/6 in GAP2020 and later; 2/3 in GAP2016/2018.</td>
                </tr>
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-3">"Best time" (<SpecRef section="9.4.1" />)</td>
                  <td class="py-2 pr-3">HG: the fastest pilot to ESS. PG: the fastest pilot who <em>also reached goal</em>.</td>
                  <td class="py-2 pr-3">As the specification.</td>
                  <td class="py-2">The same rule (GAP2020 and later, <code>pilot_speed</code>).</td>
                </tr>
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-3">ESS but not goal (<SpecRef section="13.2" />)</td>
                  <td class="py-2 pr-3">PG keeps 0% of its time points. HG keeps 80% of its time <strong>and arrival</strong> points by default.</td>
                  <td class="py-2 pr-3">As the specification.</td>
                  <td class="py-2">Reduces time and arrival points by the factor, as the specification does.</td>
                </tr>
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-3">Leading coefficient (<SpecRef section="12.3.1" />)</td>
                  <td class="py-2 pr-3">HG: classic squared-distance area. PG: weighted area. Clock from the first start gate.</td>
                  <td class="py-2 pr-3">Both variants, fixed per sport as the specification sets them. No "integrated" variant.</td>
                  <td class="py-2">Classic, weighted, and the PWC 2023 "integrated" variant.</td>
                </tr>
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-3">Leading-points curve (<SpecRef section="12.3" />)</td>
                  <td class="py-2 pr-3">LF = 1 − ((LC − LC<sub>min</sub>)/√LC<sub>min</sub>)<sup>2/3</sup>.</td>
                  <td class="py-2 pr-3">As the specification.</td>
                  <td class="py-2">As the specification.</td>
                </tr>
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-3">Arrival points (<SpecRef section="12.4" />)</td>
                  <td class="py-2 pr-3">By position only (HG).</td>
                  <td class="py-2 pr-3">By position only.</td>
                  <td class="py-2">By position by default, with an old OzGAP time-of-arrival option at double weight.</td>
                </tr>
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-3">HG distance difficulty (<SpecRef section="12.1.1" />)</td>
                  <td class="py-2 pr-3">100 m slots. Look-ahead max(30, 30·BestDist/PilotsLandedOut). Cumulative relative difficulty.</td>
                  <td class="py-2 pr-3">As the specification, reproducing AirScore's sub-slot interpolation.</td>
                  <td class="py-2">As the specification.</td>
                </tr>
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-3">Stopped task: score-back (<SpecRef section="13.4.1" />)</td>
                  <td class="py-2 pr-3">Fixed: announcement − 15 min (HG), − 5 min (PG).</td>
                  <td class="py-2 pr-3">As the specification.</td>
                  <td class="py-2">A per-competition score-back time, defaulting to 5 min for PG and 15 min for HG: the values the 2026 edition fixed.</td>
                </tr>
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-3">Stopped task: time-points reduction (<SpecRef section="13.4.5" />)</td>
                  <td class="py-2 pr-3">Every pilot is scored only to the stop. The reduction is the time points the best pilot between ESS and goal would have earned; it is subtracted from each <em>goal</em> pilot and <strong>added to the available distance points</strong>.</td>
                  <td class="py-2 pr-3">As the specification.</td>
                  <td class="py-2">Subtracts it from <em>every</em> ESS pilot's time points, and adds it to the available distance points.</td>
                </tr>
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-3">Stopped task: altitude bonus (<SpecRef section="13.4.6" />)</td>
                  <td class="py-2 pr-3">Glide ratio 5 (HG) and 2.5 (PG), from the pilot's position at the stop time. GNSS altitude.</td>
                  <td class="py-2 pr-3">As the specification.</td>
                  <td class="py-2">4 (PG) and 5 (HG) by default, configurable, over every track point. GPS altitude for PG, but barometric (QNH) altitude for HG by default.</td>
                </tr>
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-3">Cylinder tolerance (<SpecRef section="9.1.1" />)</td>
                  <td class="py-2 pr-3">Fixed: 0% relative + 5 m absolute, for every competition.</td>
                  <td class="py-2 pr-3">As the specification. A tolerance declared in the task file is ignored; every task uses the fixed band.</td>
                  <td class="py-2">0.1% + 5 m by default in GAP2020 and later; 0.5% in GAP2016/2018.</td>
                </tr>
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-3">Jump the gun (<SpecRef section="13.3" />)</td>
                  <td class="py-2 pr-3">HG only: 1 point for every X s early (default 2 s), up to Y s (default 300 s). PG is scored launch→SSS.</td>
                  <td class="py-2 pr-3">As the specification, with X and Y configurable.</td>
                  <td class="py-2">As the specification, expressed as 0.5 pt/s.</td>
                </tr>
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-3">Penalties (<SpecRef section="13.5" />)</td>
                  <td class="py-2 pr-3">Applied in order: jump-the-gun, percentage, absolute. Minimum 0.</td>
                  <td class="py-2 pr-3">Jump-the-gun and absolute penalties. <strong>No percentage penalties</strong> (<a href="https://github.com/pokle/glidecomp/issues/265" target="_blank" rel="noopener noreferrer" class="underline hover:text-foreground">issue #265</a>).</td>
                  <td class="py-2">All three, plus negative (bonus) penalties.</td>
                </tr>
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-3">Score rounding (<SpecRef section="12" />)</td>
                  <td class="py-2 pr-3">The component sum is rounded <em>once</em>, to one decimal, after penalties.</td>
                  <td class="py-2 pr-3">As the specification. Ranking and tie-breaks use the rounded value.</td>
                  <td class="py-2">Full precision internally, rounded for display only: task results to 1 decimal in GAP2020 and later, competition totals to whole points.</td>
                </tr>
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-3">Distance computation (<SpecRef section="4.2" />)</td>
                  <td class="py-2 pr-3">WGS84 ellipsoid.</td>
                  <td class="py-2 pr-3">WGS84 Vincenty inverse and direct, one of the three algorithms <SpecRef section="7.1.4" label="§7.1.4" /> allows. Routes are optimised with the <SpecRef section="7.1.3" label="§7.1.3" /> PathFinder algorithm over the <SpecRef section="7.1.2" label="§7.1.2" /> local projection, then corrected back onto the control-zone boundaries (<SpecRef section="7.1.7" label="§7.1.7" />).</td>
                  <td class="py-2">WGS84 Karney geodesics (geographiclib). Routes differ by metres, which causes small differences in absolute points.</td>
                </tr>
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-3">Series scoring / FTV</td>
                  <td class="py-2 pr-3">Task ranking and competition totals, optionally with FTV (§14–16).</td>
                  <td class="py-2 pr-3">Competition totals as a sum of task scores or with FTV (S7F §16), ranked per class (S7A ties), with top 3 per task and teams. FTV is the default for new PG competitions.</td>
                  <td class="py-2">Implemented. FTV is the PG preset default, with factor 0.75.</td>
                </tr>
              </tbody>
            </table>
          </div>

          <p class="text-muted-foreground">
            Features GlideComp doesn't implement are listed in the previous section. These are
            the other places where it departs from the letter of the specification:
          </p>

          <div class="space-y-4 ml-2">
            <div>
              <h3 class="text-base font-semibold mb-1">Start gates: placeholder midnight gates are ignored (<SpecRef section="6.3.1" />)</h3>
              <p class="text-muted-foreground">
                Otherwise, start gates work as the specification says. Each pilot's start time is
                the last gate at or before their start-cylinder crossing
                (<SpecRef section="9.2.4.1" />), and a crossing before the first gate can't
                validate a start (<SpecRef section="9.2" />). With one gate, the start is the
                first crossing after it, and a later crossing doesn't replace it. With several
                gates, the start is the last crossing before the pilot carried on along the
                course, so a pilot can go back for a later gate (<SpecRef section="9.2.4" />).
                Early starts follow <SpecRef section="13.3" />: paragliders are scored
                launch→start, and hang gliders get the jump-the-gun penalty. The
                leading-coefficient clock runs from the first gate (<SpecRef section="12.3.1" />).
              </p>
              <p class="text-muted-foreground mt-2">
                The one difference: if the <em>only</em> gate of a race is exactly 00:00:00 UTC,
                GlideComp treats the task as having no gates and times it as a time trial. Some
                tools write a single midnight gate just to satisfy the file format's rule that the
                gate list can't be empty, and a real gate at midnight UTC doesn't happen in
                practice.
              </p>
            </div>
            <div>
              <h3 class="text-base font-semibold mb-1">One leading-weight formula, for every competition (<SpecRef section="11" />)</h3>
              <p class="text-muted-foreground">
                The 2026 specification sets the leading weight from a per-task
                <em>Leading&nbsp;Time&nbsp;Ratio</em>, in both sports. GlideComp applies this
                formula to <strong>every</strong> competition, including historical ones first
                published under an earlier generation. Those pages carry a notice that their
                scores are indicative. This is the one place a GlideComp score can differ from an
                old published score by design rather than by mistake.
              </p>
              <p class="text-muted-foreground mt-2">
                A competition sets its Leading&nbsp;Time&nbsp;Ratio (0% to 26%) in its scoring
                settings. The defaults are the specification's own: 26% for paragliding, 17.5%
                for hang gliding.
              </p>
            </div>
            <div>
              <h3 class="text-base font-semibold mb-1">Line control zones are only supported at goal (<SpecRef section="6.2.2" />, <SpecRef section="9.2.2" />)</h3>
              <p class="text-muted-foreground">
                GlideComp scores a goal line as the specification defines it: through the goal
                waypoint, perpendicular to the final leg, with the semi-circular control zone
                behind it, the goal-line tolerance of <SpecRef section="9.1.3" />, and crossed in
                the direction of the last leg. Goal is the only place GlideComp understands a
                line. The specification also allows one at an intermediate turnpoint, but the
                .xctsk task format can't describe it, so no task can ask for one and every
                turnpoint before goal is treated as a cylinder. Tracked in
                <a href="https://github.com/pokle/glidecomp/issues/359" target="_blank" rel="noopener noreferrer" class="underline hover:text-foreground">issue #359</a>;
                add your thoughts there if it matters for your competition.
              </p>
            </div>
            <div>
              <h3 class="text-base font-semibold mb-1">"Open distance" means the classic format, not a GAP task type</h3>
              <p class="text-muted-foreground">
                GlideComp's <a href="/scoring/open-distance" class="underline hover:text-foreground">open-distance competitions</a>
                use the classic free-flight format: one take-off, pilots fly as far as they can,
                and the score is the straight-line distance from the edge of the take-off
                cylinder. Earlier editions of the specification also had an <em>open distance
                task</em> within GAP, but the 2025 edition removed it, and the 2026 edition
                covers only Race and Time Trial tasks. A GlideComp task with control zones
                always scores as a Race.
              </p>
            </div>
            <div>
              <h3 class="text-base font-semibold mb-1">Launch window: only provable violations are enforced (<SpecRef section="9.3" />)</h3>
              <p class="text-muted-foreground">
                The specification counts a pilot's turnpoints only if they launched inside the
                launch window. GlideComp enforces the half of this rule a tracklog can prove. A
                start-cylinder crossing <em>before</em> the window opens
                (<code>takeoff.timeOpen</code> in the task file) shows the pilot was airborne
                before launch was allowed, so that crossing can't validate a start, and the
                report card says why.
              </p>
              <p class="text-muted-foreground mt-2">
                A tracklog alone can't prove <em>when</em> someone launched, so GlideComp won't
                catch a pilot who launched early but started the course after the window opened,
                or one who launched after it closed. Launch time isn't part of scoring; the
                scorekeeper decides these cases and can add a penalty by hand.
              </p>
            </div>
            <div>
              <h3 class="text-base font-semibold mb-1">Smaller details</h3>
              <ul class="list-disc list-inside text-muted-foreground space-y-2 ml-2">
                <li>
                  <strong>The two-fix rule is not a second way to reach a goal line (<SpecRef section="9.2.2" />):</strong>
                  <SpecRef section="9.2.2" /> also accepts a line crossing from two consecutive
                  fixes on opposite sides of it, if flying around the end of the line would have
                  needed more than 120&nbsp;km/h. GlideComp doesn't use this as an extra way to
                  reach goal. A pilot whose straight path between two fixes passes outside the
                  end of the line went around it at their own speed, so the test says nothing
                  about them; on its own it would award goal to a pilot who crossed the line's
                  extension a kilometre past the end. The case the test is meant for, a crossing
                  so close to the end that measurement could put it either side, is already
                  covered by the line tolerance. A goal line is reached by crossing it
                  (<SpecRef section="9.2.3" />) or by a fix in the control zone behind it.
                </li>
                <li>
                  <strong>Mis-set task deadlines are ignored (<SpecRef section="9.2" />):</strong>
                  the goal deadline otherwise applies as the specification says: a crossing after
                  it doesn't count, and a landed-out pilot's distance is measured only up to it
                  (<SpecRef section="12.1" />). The one guard is for task-setting mistakes that
                  would give every pilot zero: a deadline at or before the first start gate, or a
                  launch window that opens at or after the deadline. GlideComp treats such a
                  deadline as unset, as it does a missing SSS or ESS. If the deadline changed a
                  pilot's score, the report card shows the cutoff time and each crossing it
                  ignored.
                </li>
                <li>
                  <strong>Hang gliding goal lines use the paragliding semi-circle rule (<SpecRef section="9.2.3" />):</strong>
                  in the specification, entering the control semi-circle behind the goal line
                  counts as a crossing only in paragliding; in hang gliding only crossing the
                  line itself counts. GlideComp applies the paragliding rule to both sports. The
                  direction of crossing is checked for both, so a pilot who crosses the wrong way
                  doesn't reach goal. The effect is tiny, because a pilot who gets behind the line
                  has almost always entered the semi-circle. Tracked in
                  <a href="https://github.com/pokle/glidecomp/issues/359" target="_blank" rel="noopener noreferrer" class="underline hover:text-foreground">issue #359</a>.
                </li>
                <li>
                  <strong>Leading coefficient: track points after the deadline (<SpecRef section="12.3.1" />):</strong>
                  the specification counts a track point recorded after the task deadline as if
                  it were at the deadline. GlideComp counts it at its own time, which makes the
                  leading coefficient slightly worse than the specification would for a pilot who
                  kept going. It only affects a pilot still flying towards ESS after the deadline,
                  who earned no more distance for it anyway. The
                  <a href="#leading-max-time" class="underline hover:text-foreground">end of the curve</a>
                  itself follows the specification.
                </li>
                <li>
                  <strong>Times carry fractions of a second (<SpecRef section="9.4" />):</strong>
                  the specification's smallest unit of time is one second. GlideComp interpolates
                  each crossing between the two nearest fixes, so a speed-section time can include
                  a fraction of a second. That's more precise, but time points can differ by a
                  fraction of a point from a scorer that works in whole seconds. Tracked in
                  <a href="https://github.com/pokle/glidecomp/issues/586" target="_blank" rel="noopener noreferrer" class="underline hover:text-foreground">issue #586</a>.
                </li>
                <li>
                  <strong>Optional leading and arrival points:</strong> the specification always
                  has a leading weight, and an arrival weight for hang gliding classes 1 and 5.
                  GlideComp follows the FAI formula by default (leading on for both sports,
                  arrival on for hang gliding), but a competition can turn either off, as is
                  common in club scoring. A competition that does so departs from the
                  specification.
                </li>
                <li>
                  <strong>Distance origin:</strong> the optional
                  <a href="#distance-origin" class="underline hover:text-foreground">"start cylinder" distance origin</a>
                  deliberately departs from the specification's launch-to-goal task distance
                  (<SpecRef section="7.2" />), to match the wording of some national rules such
                  as HGFA/SAFA. The default "take-off" setting follows the specification.
                </li>
                <li>
                  <strong>Distance precision:</strong> distances are computed on the WGS84
                  ellipsoid, as the specification requires (<SpecRef section="4.2" />), and the
                  route optimiser uses the specification's own algorithms
                  (<SpecRef section="7.1" label="§7.1" />): the local projection, the PathFinder
                  crossing and reflection constructions with the 0.1 m threshold, and the
                  projection correction back onto the control-zone boundaries. One internal
                  difference remains: the reflection case is solved by numeric search rather than
                  the referenced paper's closed form, which finds the same point a different way.
                  So the optimised route isn't bit-identical to another tool's, such as
                  <a href="https://airscore.org" target="_blank" rel="noopener noreferrer" class="underline hover:text-foreground">AirScore</a>,
                  and a landed-out pilot's points can differ slightly. This affects absolute
                  points more than rankings.
                </li>
              </ul>
            </div>
          </div>

          <p class="text-muted-foreground">
            If one of these differences matters for your competition, or you find one this page
            doesn't list,
            <a href="https://github.com/pokle/glidecomp/issues" target="_blank" rel="noopener noreferrer" class="underline hover:text-foreground">open an issue on GitHub</a>.
            Transparent scoring is the whole point of this project.
          </p>
        </div>
      </section>

