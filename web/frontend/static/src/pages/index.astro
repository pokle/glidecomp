---
/**
 * Landing page — Apple-style marketing layout inspired by get-inscribe.com:
 * glass nav (Base/SiteHeader), big hero with accent line, framed screenshot
 * with a blue glow, trust strip, FAQ, CTA band, full footer (Base/SiteFooter).
 *
 * Screenshots live in static/src/assets/screenshots/ (captured from the real
 * app) — in src/, NOT public/, so Astro's image pipeline transcodes them. They
 * are the page's whole byte weight: the originals are 2400px-wide PNGs and the
 * hero alone was 2.44 MB, on the page that decides whether a visitor tries
 * GlideComp at all. <Picture> emits AVIF and WebP with a PNG fallback and a
 * srcset per display width, so a phone fetches a fraction of it. Everything
 * still lands in the prerendered HTML — <picture> needs no JavaScript.
 */
import Base from "../layouts/Base.astro";
import { Picture } from "astro:assets";
import pilotExplain from "../assets/screenshots/pilot-explain.png";
import behindLeader from "../assets/screenshots/analysis-behind-leader.png";
import fieldHeatmap from "../assets/screenshots/analysis-field-heatmap.png";
import speedRank from "../assets/screenshots/analysis-speed-rank.png";
import thermalTop from "../assets/screenshots/analysis-thermal-top.png";
import climbStrength from "../assets/screenshots/analysis-climb-strength.png";
import windLegs from "../assets/screenshots/analysis-wind-legs.png";

// The hero renders at min(980px, 92vw); the chart plates fill the 1120px
// container. Widths cover those at 1x and 2x — anything larger is detail no
// display can show.
//
// Clamped to each source's own width: asking for more pixels than the original
// has makes Astro UPSCALE, and a re-encoded upscale is bigger than the file it
// came from (a 1712px-wide chart requested at 2048 came out larger than the
// original PNG). Never ask for detail that isn't there.
const widthsFor = (img: { width: number }, widths: number[]) => {
  const within = widths.filter((w) => w < img.width);
  return within.length === widths.length ? within : [...within, img.width];
};
// The report card sits in the right half of the stage split — ~460px at full
// width, the whole page scaled down to an impression rather than a read.
const HERO_WIDTHS = [340, 460, 690, 920];
const HERO_SIZES = "(max-width: 820px) 74vw, 460px";
const CHART_WIDTHS = [512, 1024, 1536];
const CHART_SIZES = "(max-width: 1120px) 92vw, 1024px";
---

<Base
  title="GlideComp — same air, same task, see where the race was really won"
  description="GlideComp analyses every track flown in a hang gliding or paragliding competition — how the fast pilots climbed, glided and chose their lines — and scores the comp in the browser, GAP or open distance, every point explained."
>
  <!-- ===================== Hero ===================== -->
  <section class="hero">
    <div class="container">
      <h1 class="hero-title fade-in">
          Same air. Same task.
          <span class="accent">See where the race was really won.</span>
      </h1>
      <p class="hero-description fade-in" style="--delay:.05s">
        GlideComp compares every track flown on the day — who climbed better,
        who glided smarter, whose decisions paid off — so you can see exactly
        what the fast pilots did differently and take it to the next comp.
        Scoring comes built in: GAP or open distance, in your browser, every
        point explained.
      </p>
      <div class="hero-cta fade-in" style="--delay:.1s">
        {/* Submitting a track is deliberately NOT here. It lives in the nav,
            which is on every page — the hero's job is to explain what
            GlideComp is to somebody who has never seen it, and a third
            competing action was buying reach with clarity. */}
        <button type="button" class="button button-primary" data-signin>
          Start a competition
        </button>
        <a class="button button-secondary" href="/comp">Browse competitions</a>
      </div>
      <p class="hero-note fade-in" style="--delay:.15s">
        Free · Submit a track and read the scores without an account
      </p>
    </div>
    <div class="hero-stage fade-in" style="--delay:.2s">
      <div class="hero-glow"></div>
      <div class="stage-split">
        <div class="stage-caption">
          <h2 class="eyebrow">Pilot's GAP scores explained</h2>
          <p>
            GlideComp explains why your pilot scored the way they did. Distance
            points, time points, all explained in plain English.
          </p>
          <ul class="stage-list">
            <li>Every start-cylinder crossing, and which one scored</li>
            <li>The day's validity — how many points were on offer at all</li>
            <li>Distance split into its linear and difficulty halves</li>
            <li>Why the time points were zero</li>
          </ul>
          <!-- Comp-level, not per-pilot: only the comp sqid survives a reseed,
               so a task/pilot URL here would 404 the next time the sample comp
               is seeded. -->
          <a class="stage-link" href="/comp/corryong-cup-2026-voqc/scores">
            See a real comp's scores
            <span aria-hidden="true">→</span>
          </a>
          <p class="stage-hint">
            Click any score to open that pilot's report card.
          </p>
        </div>
        <figure class="shot shot-hero">
          <Picture
            src={pilotExplain}
            alt="A whole pilot report card in GlideComp, scaled down: the flight's start-cylinder crossings and turnpoints beside a map of the task, then the day's validity, then distance, time, leading and arrival points each broken out with their arithmetic, down to the total"
            widths={widthsFor(pilotExplain, HERO_WIDTHS)}
            sizes={HERO_SIZES}
            formats={["avif"]}
            fallbackFormat="webp"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      </div>
    </div>
  </section>

  <!-- ===================== Trust strip ===================== -->
  <section class="trust">
    <div class="container">
      <div class="trust-row">
        <div class="trust-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"></path></svg>
          <span>GAP &amp; open-distance scoring</span>
        </div>
        <div class="trust-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"></path></svg>
          <span>Field analysis across every pilot</span>
        </div>
        <div class="trust-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"></path></svg>
          <span>IGC files from any instrument</span>
        </div>
        <div class="trust-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"></path></svg>
          <span>XCTrack task import (.xctsk)</span>
        </div>
        <div class="trust-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"></path></svg>
          <span>Public audit log</span>
        </div>
        <div class="trust-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"></path></svg>
          <span>Nothing to install</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== Learn (the pilot pitch) ===================== -->
  <section class="section-pad" id="learn">
    <div class="container">
      <div class="section-header fade-in">
        <span class="eyebrow">For pilots</span>
        <h2>Everyone flew the same air. Why were they faster?</h2>
        <p>
          The scores tell you who won. GlideComp's analysis tells you what
          separated the field — by measuring every track flown on the task
          against every other one.
        </p>
      </div>

      <!-- Chart tabs. Every panel is in the DOM and the track scrolls
           natively, so with JS off (or before it runs) all six are still
           readable by swiping — the script below only adds the tab
           affordance on top. Names in these charts are pseudonymised. -->
      <div class="charts fade-in" id="charts">
        <div class="chart-tabs-shell">
          <div class="chart-tabs" role="tablist" aria-label="Field analysis charts">
            <button role="tab" type="button" id="ct-0" aria-controls="cp-0" aria-selected="true" tabindex="0">Behind the leader</button>
            <button role="tab" type="button" id="ct-1" aria-controls="cp-1" aria-selected="false" tabindex="-1">The whole field</button>
            <button role="tab" type="button" id="ct-2" aria-controls="cp-2" aria-selected="false" tabindex="-1">Speed vs result</button>
            <button role="tab" type="button" id="ct-3" aria-controls="cp-3" aria-selected="false" tabindex="-1">How high it went</button>
            <button role="tab" type="button" id="ct-4" aria-controls="cp-4" aria-selected="false" tabindex="-1">When it switched on</button>
            <button role="tab" type="button" id="ct-5" aria-controls="cp-5" aria-selected="false" tabindex="-1">Wind, leg by leg</button>
          </div>
          <div class="chart-indicator" aria-hidden="true"></div>
        </div>

        <div class="chart-track" id="chart-track">
          <section role="tabpanel" id="cp-0" aria-labelledby="ct-0" tabindex="0">
            <figure class="chart-card">
              <div class="chart-plate">
                <Picture
                  src={behindLeader}
                  alt="Line chart: minutes behind the fastest pilot at each of seven turnpoints. The leader runs flat along zero at the top, the next four are picked out in colour, and the rest of the field fans downward in grey with several lines stopping early."
                  widths={widthsFor(behindLeader, CHART_WIDTHS)}
                  sizes={CHART_SIZES}
                  formats={["avif"]}
                  fallbackFormat="webp"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <figcaption class="chart-note">
                <strong>Minutes behind the leader, turnpoint by turnpoint.</strong>
                Every pilot's race against the fastest one. Lines that stop early
                are pilots who landed out.
              </figcaption>
            </figure>
          </section>

          <section role="tabpanel" id="cp-1" aria-labelledby="ct-1" tabindex="0">
            <figure class="chart-card">
              <div class="chart-plate">
                <Picture
                  src={fieldHeatmap}
                  alt="Heatmap: 32 pilots down the side in finishing order, 24 behavioural metrics across the top grouped by family, each cell shaded by percentile. The top rows are visibly darker across most columns."
                  widths={widthsFor(fieldHeatmap, CHART_WIDTHS)}
                  sizes={CHART_SIZES}
                  formats={["avif"]}
                  fallbackFormat="webp"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <figcaption class="chart-note">
                <strong>Every pilot against every metric.</strong>
                Rows are pilots in finishing order, columns are the measures,
                darker is a better percentile. The dark band along the top is
                what winning looked like.
              </figcaption>
            </figure>
          </section>

          <section role="tabpanel" id="cp-2" aria-labelledby="ct-2" tabindex="0">
            <figure class="chart-card">
              <div class="chart-plate">
                <Picture
                  src={speedRank}
                  alt="Scatter plot: each dot is a pilot, gliding speed on the horizontal axis from 38 to 72 km/h, finishing rank up the vertical axis with rank 1 at the top, and a fitted trend curve rising left to right."
                  widths={widthsFor(speedRank, CHART_WIDTHS)}
                  sizes={CHART_SIZES}
                  formats={["avif"]}
                  fallbackFormat="webp"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <figcaption class="chart-note">
                <strong>Gliding speed against finishing rank.</strong>
                One dot per pilot. The strongest separator on this task: the
                pilots who glided faster between climbs finished ahead.
              </figcaption>
            </figure>
          </section>

          <section role="tabpanel" id="cp-3" aria-labelledby="ct-3" tabindex="0">
            <figure class="chart-card">
              <div class="chart-plate">
                <Picture
                  src={thermalTop}
                  alt="Height against time: a filled orange thermal-top line and a dashed pink cloud-base line, both climbing to about 3000 metres by mid-afternoon before the orange line drops away after 18:30."
                  widths={widthsFor(thermalTop, CHART_WIDTHS)}
                  sizes={CHART_SIZES}
                  formats={["avif"]}
                  fallbackFormat="webp"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <figcaption class="chart-note">
                <strong>Thermal top against cloud base.</strong>
                The working band through the day, from the weather model. The
                orange line falling away is the day shutting down.
              </figcaption>
            </figure>
          </section>

          <section role="tabpanel" id="cp-4" aria-labelledby="ct-4" tabindex="0">
            <figure class="chart-card">
              <div class="chart-plate">
                <Picture
                  src={climbStrength}
                  alt="Climb rate by hour: a median line around 1 to 2 metres per second with shaded percentile bands, start gates and the task deadline marked with vertical rules, and rows beneath showing takeoff times and climb counts."
                  widths={widthsFor(climbStrength, CHART_WIDTHS)}
                  sizes={CHART_SIZES}
                  formats={["avif"]}
                  fallbackFormat="webp"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <figcaption class="chart-note">
                <strong>How strong the climbs were, hour by hour.</strong>
                Measured from the field's own tracks, not a model — so you can
                see the day weakening under the pilots still on course.
              </figcaption>
            </figure>
          </section>

          <section role="tabpanel" id="cp-5" aria-labelledby="ct-5" tabindex="0">
            <figure class="chart-card">
              <div class="chart-plate">
                <Picture
                  src={windLegs}
                  alt="Gantt-style chart: one row per task leg on a time axis. Each row has a pale bar spanning when the field flew that leg and a solid band inside it spanning the circling its wind was measured from, with an arrow for wind direction and a label giving speed and compass point."
                  widths={widthsFor(windLegs, CHART_WIDTHS)}
                  sizes={CHART_SIZES}
                  formats={["avif"]}
                  fallbackFormat="webp"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <figcaption class="chart-note">
                <strong>What the wind did on each leg.</strong>
                The pale bar is the time when the field flew the leg. The
                solid band inside it is the circling that the wind was
                estimated from. On a leg that everyone glided, that band is
                very small.
              </figcaption>
            </figure>
          </section>
        </div>

        <p class="chart-source">
          From Corryong Cup 2026, Task 1 — 32 pilots. Names are shortened to
          letters here, in finishing order.
        </p>
      </div>

      <div class="feature-grid fade-in">
        <article class="feature-card">
          <h3>Climbing</h3>
          <p>
            Whether you out-climbed the pilots sharing your thermal, how long
            you took to find the core, how high in the day's band you topped
            out, and whether you left good lift or milked it until it died.
          </p>
        </article>
        <article class="feature-card">
          <h3>Gliding</h3>
          <p>
            Speed between climbs, glide angle against the rest of the field,
            how far you drifted off the course line, and whether you pushed
            harder when the next climb was stronger.
          </p>
        </article>
        <article class="feature-card">
          <h3>Decision-making</h3>
          <p>
            How low you were willing to go before committing to the next
            climb, the low saves you dug out, distance covered between
            thermals, and how much of the race you spent hunting.
          </p>
        </article>
        <article class="feature-card">
          <h3>Gaggle</h3>
          <p>
            Time spent flying with others, climbs you joined on someone else's
            marker, and how often going it alone actually paid off.
          </p>
        </article>
        <article class="feature-card">
          <h3>Race craft</h3>
          <p>
            How long after the gate opened you started, where race time went
            leg by leg, how far behind the leader you reached ESS, and what
            height you had left when you got there.
          </p>
        </article>
        <article class="feature-card">
          <h3>The day itself</h3>
          <p>
            Wind and climb strength hour by hour, drawn from the field's own
            tracks and read against the weather model — because half of what
            looks like skill is really the day you got.
          </p>
        </article>
      </div>
      <p class="section-footnote fade-in">
        Every metric is ranked by how strongly it actually separated the field
        that day, and checked across the comp's other tasks — so you can tell a
        real lesson from a quirk of one day's weather. Each pilot's score comes
        with the same treatment: a plain-English timeline of the flight, on the
        map and in 3D.
        {/* A real, warm report on a real comp. The `bqlf` task id is assigned
            by D1 and is NOT stable across a reseed of Corryong Cup 2026 (the
            comp sqid `voqc` is) — if that comp is reseeded, re-read the task
            id from /api/comp/voqc and update this href. */}
        <a href="/comp/corryong-cup-2026-voqc/analysis/task/task-1-open-bqlf">
          See the report for Corryong Cup 2026, Task 1&nbsp;→
        </a>
      </p>
    </div>
  </section>

  <!-- ===================== Organisers ===================== -->
  <section class="section-pad bg-soft" id="organisers">
    <div class="container">
      <div class="section-header fade-in">
        <span class="eyebrow">For organisers &amp; scorers</span>
        <h2>The scoring runs itself</h2>
        <p>
          No software to install, no spreadsheet to babysit, and nobody
          waiting on the scorer at the end of the day.
        </p>
      </div>
      <div class="feature-grid fade-in">
        <article class="feature-card">
          <h3>Set the task</h3>
          <p>
            Import or build the task in the browser, then share it — pilots
            scan a QR code to load it straight into XCTrack, Flyskyhy or
            SeeYou Navigator.
          </p>
        </article>
        <article class="feature-card">
          <h3>Pilots upload their own tracks</h3>
          <p>
            IGC from any instrument, submitted by the pilot or by you on their
            behalf. Scores recompute as tracks land, and every task page is
            public the moment it exists.
          </p>
        </article>
        <article class="feature-card">
          <h3>Every point explained</h3>
          <p>
            GAP to the CIVL formulas or a simple open-distance format, with
            penalties, corrections and task edits all recorded in a public
            audit log. Nobody has to take the numbers on trust.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ===================== FAQ ===================== -->
  <section class="section-pad" id="faq">
    <div class="container">
      <div class="section-header fade-in">
        <span class="eyebrow">?</span>
        <h2>Questions?</h2>
      </div>
      <div class="faq-grid fade-in">
        <div class="faq-item">
          <button class="faq-question" type="button" aria-expanded="false">
            <h3>What do I need to run a comp with GlideComp?</h3>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
          </button>
          <div class="faq-answer">
            <p>
              A browser. Sign in, create the competition, add a task, and
              share the link. Pilots upload their IGC tracks, and GlideComp
              scores them automatically. There is no software to install and
              no spreadsheet to maintain.
            </p>
          </div>
        </div>
        <div class="faq-item">
          <button class="faq-question" type="button" aria-expanded="false">
            <h3>How are scores calculated?</h3>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
          </button>
          <div class="faq-answer">
            <p>
              With the GAP formulas that FAI competitions use: distance, time
              and leading points. A new competition gets the official
              defaults, and you can change the advanced parameters when you
              need to. There is also an open-distance format for club XC
              days. The <a href="/scoring">scoring guide</a> explains both in
              detail.
            </p>
          </div>
        </div>
        <div class="faq-item">
          <button class="faq-question" type="button" aria-expanded="false">
            <h3>What can I actually learn from the analysis?</h3>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
          </button>
          <div class="faq-answer">
            <p>
              Where your day went, against every pilot who flew the same
              task. GlideComp measures each pilot's climbing, gliding,
              decision-making, gaggle flying and race craft from the track
              logs. It then ranks those measures by how strongly they
              separated the field, so the report starts with what was
              important on the day. Read it beside your own report card, and
              you have something specific to work on before the next
              competition.
            </p>
          </div>
        </div>
        <div class="faq-item">
          <button class="faq-question" type="button" aria-expanded="false">
            <h3>Who can see my track?</h3>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
          </button>
          <div class="faq-answer">
            <p>
              Anyone who follows the competition. A track submitted for
              scoring becomes part of the public record of that task. That
              record is what makes the comparison possible, and every pilot in
              the field accepts the same terms. A flight that you analyse
              privately, outside a competition, stays yours.
            </p>
          </div>
        </div>
        <div class="faq-item">
          <button class="faq-question" type="button" aria-expanded="false">
            <h3>Do pilots need accounts?</h3>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
          </button>
          <div class="faq-answer">
            <p>
              Not to follow a competition, because competitions, tasks and
              scores are public pages. To submit a track, sign in with Google
              or with a one-time code sent to your email. An organiser can
              also upload tracks for a pilot.
            </p>
          </div>
        </div>
        <div class="faq-item">
          <button class="faq-question" type="button" aria-expanded="false">
            <h3>Does it work with XCTrack and my instrument?</h3>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
          </button>
          <div class="faq-answer">
            <p>
              Yes. Tasks import and export as .xctsk, and waypoints download
              in standard formats. Pilots can scan a QR code to load the task
              or the waypoints directly into XCTrack, Flyskyhy, SeeYou
              Navigator and most other flight apps. Any instrument that
              produces an IGC file works for scoring.
            </p>
          </div>
        </div>
        <div class="faq-item">
          <button class="faq-question" type="button" aria-expanded="false">
            <h3>What about penalties and score corrections?</h3>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
          </button>
          <div class="faq-answer">
            <p>
              Apply a penalty with a reason, and the scores recompute
              immediately. A public audit log records every change that can
              move a score: penalties, re-uploads and task edits. Pilots can
              therefore always see why the numbers changed.
            </p>
          </div>
        </div>
        <div class="faq-item">
          <button class="faq-question" type="button" aria-expanded="false">
            <h3>How much does it cost?</h3>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
          </button>
          <div class="faq-answer">
            <p>
              GlideComp is free to use, and Tushar Pokle sponsors it. It is an
              open project, and the source is on
              <a href="https://github.com/pokle/glidecomp" target="_blank" rel="noopener noreferrer">GitHub</a>.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== CTA ===================== -->
  <section class="cta-section bg-soft" id="start">
    <div class="container">
      <div class="fade-in">
        <h2>Fly it, score it, learn from it</h2>
        <p>
          Create a competition, import your task, and have the standings — and
          the day's analysis — waiting before the retrieve gets back.
        </p>
        <div class="cta-buttons">
          <button type="button" class="button button-primary button-large" data-signin>
            Start a competition
          </button>
          <a class="button button-secondary button-large" href="/comp">See a sample comp</a>
