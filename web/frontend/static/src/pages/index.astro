<script>
  // Hero + CTA buttons route to the sign-in page (Google or an emailed
  // code) rather than straight into Google OAuth.
  for (const el of document.querySelectorAll("[data-signin]")) {
    el.addEventListener("click", () => window.location.assign("/signin?next=/comp"));
  }

  // Reveal-on-scroll. The `js` class arms the initial hidden state (CSS above),
  // so content is never hidden for no-JS visitors or crawlers.
  document.documentElement.classList.add("js");
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add("in");
          observer.unobserve(entry.target);
        }
      }
    },
    { rootMargin: "0px 0px -8% 0px", threshold: 0.1 }
  );
  for (const el of document.querySelectorAll(".fade-in")) observer.observe(el);

  // FAQ accordion.
  for (const item of document.querySelectorAll(".faq-item")) {
    const button = item.querySelector(".faq-question");
    button?.addEventListener("click", () => {
      const open = item.classList.toggle("active");
      button.setAttribute("aria-expanded", String(open));
    });
  }

  // Chart tabs (ARIA tabs pattern, ~40 lines of plain DOM — no component
  // library on the static pages). The panels are already scrollable without
  // this: all it adds is the tab affordance, the sliding indicator, and
  // keyboard support.
  const chartTabs = /** @type {HTMLButtonElement[]} */ ([
    ...document.querySelectorAll('.chart-tabs [role="tab"]'),
  ]);
  if (chartTabs.length) {
    const track = document.getElementById("chart-track");
    const panels = /** @type {HTMLElement[]} */ ([
      ...document.querySelectorAll('.chart-track [role="tabpanel"]'),
    ]);
    const indicator = document.querySelector(".chart-indicator");
    const smooth = window.matchMedia("(prefers-reduced-motion: reduce)").matches
      ? "auto"
      : "smooth";
    let current = 0;

    const moveIndicator = () => {
      const tab = chartTabs[current];
      indicator.style.width = tab.offsetWidth + "px";
      indicator.style.transform = "translateX(" + tab.offsetLeft + "px)";
    };

    const paint = (i) => {
      current = i;
      chartTabs.forEach((t, n) => {
        t.setAttribute("aria-selected", String(n === i));
        t.tabIndex = n === i ? 0 : -1;
      });
      moveIndicator();
      // Keep the selected tab visible when the tab strip itself has scrolled.
      chartTabs[i].scrollIntoView({ block: "nearest", inline: "nearest", behavior: smooth });
    };

    const goTo = (i, focusTab) => {
      i = Math.max(0, Math.min(chartTabs.length - 1, i));
      panels[i].scrollIntoView({ block: "nearest", inline: "center", behavior: smooth });
      paint(i);
      if (focusTab) chartTabs[i].focus();
    };

    chartTabs.forEach((tab, i) => tab.addEventListener("click", () => goTo(i)));

    document.querySelector(".chart-tabs").addEventListener("keydown", (e) => {
      const next = {
        ArrowRight: current + 1,
        ArrowLeft: current - 1,
        Home: 0,
        End: chartTabs.length - 1,
      }[e.key];
      if (next === undefined) return;
      e.preventDefault();
      goTo(next, true);
    });

    // A swipe is just a scroll — watch which panel settles and let the tabs
    // follow it, rather than listening for pointer drags.
    const panelObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting && entry.intersectionRatio > 0.55) {
            const i = panels.indexOf(entry.target);
            if (i !== -1 && i !== current) paint(i);
          }
        }
      },
      { root: track, threshold: [0.55, 0.9] }
    );
    for (const panel of panels) panelObserver.observe(panel);

    window.addEventListener("resize", moveIndicator);
    // Web fonts land after first paint and change the tab widths.
    document.fonts?.ready.then(moveIndicator);
    moveIndicator();
  }
</script>
