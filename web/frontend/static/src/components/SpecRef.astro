---
/**
 * Link to a section of the FAI Sporting Code Section 7F (2026 edition V1.0,
 * effective 1 May 2026) PDF.
 *
 * The fragment `#page=N` (Adobe "PDF Open Parameters") lands the reader on
 * the section's page in Chrome's built-in viewer, Acrobat and pdf.js. The
 * page numbers are derived from the page markers in GlideComp's own
 * transcription of the edition
 * (docs/reference/fai-s7f-xc-scoring-2026/s7f-xc-scoring-2026.md), so the
 * table can be regenerated mechanically when an edition changes.
 *
 * Usage:
 *   <SpecRef section="12.2" />                  → renders "§12.2" as a link
 *   <SpecRef section="10" label="FAI S7F §10" /> → custom link text
 */
interface Props {
  /** Spec section number, e.g. "12.2" or "9.2.4.1". */
  section: string;
  /** Link text. Defaults to "§{section}". */
  label?: string;
  /** Extra classes appended to the default link styling. */
  class?: string;
}

const S7F_PDF =
  "https://www.fai.org/sites/default/files/civl/documents/sporting_code_s7_f_-_xc_scoring_2026.pdf";

/** Physical PDF page for each referenced section (2026 edition V1.0). */
const SPEC_DESTS: Record<string, number> = {
  "2": 8, // The GAP Philosophy
  "4.2": 13, // Distance between two points
  "5": 14, // Competition Parameters
  "6": 16, // Task Setting
  "6.2.2": 17, // Line control zone
  "6.2.3": 19, // Goal
  "6.2.3.1": 19, // Goal line
  "6.3.1": 21, // Race (start gates)
  "6.3.2": 21, // Time Trial
  "7": 22, // Task and flight distance calculations
  "7.1.3": 23, // PathFinder
  "7.1.4": 23, // DirectGeodesic & InverseGeodesic
  "7.1.5": 24, // EllipsoidDistance
  "7.2": 26, // Task distances
  "8": 27, // Flying a task
  "9": 28, // Task evaluation
  "9.1.1": 28, // Cylinder tolerance
  "9.1.2": 28, // Line tolerance
  "9.1.3": 28, // Goal line tolerance
  "9.2": 29, // Control zone validation
  "9.2.2": 30, // Line crossings
  "9.2.3": 30, // Goal crossing
  "9.2.4": 31, // Validation
  "9.2.4.1": 31, // Start time
  "9.3": 31, // Flown distance
  "9.4": 32, // Time for speed section
  "9.4.1": 32, // Best time
  "10": 33, // Task Validity
  "10.1": 33, // Launch Validity
  "10.2": 33, // Distance Validity
  "10.3": 34, // Time Validity
  "11": 35, // Points Allocation
  "12": 37, // Pilot score
  "12.1": 37, // Distance points
  "12.1.1": 37, // Difficulty calculation
  "12.2": 39, // Time points
  "12.3": 39, // Leading points
  "12.3.1": 40, // Leading coefficient
  "12.4": 42, // Arrival points
  "13.1": 44, // Underflying Elevated Goal
  "13.2": 44, // ESS but not goal
  "13.3": 45, // Early start
  "13.4": 45, // Stopped tasks
  "13.5": 48, // Penalties
  "14": 49, // Task ranking
  "15": 50, // Competition ranking
  "16": 51, // FTV
};

const { section, label, class: extraClass = "" } = Astro.props;
const page = SPEC_DESTS[section];
const href = page ? `${S7F_PDF}#page=${page}` : S7F_PDF;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class:list={["underline hover:text-foreground", extraClass]}
>
  {label ?? `§${section}`}
</a>
