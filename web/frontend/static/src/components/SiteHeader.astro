---
/**
 * Global glass menu bar for the static pages (Inscribe-style): sticky,
 * translucent, backdrop-blurred, with a right-aligned account slot.
 * min-h-[60px] matches the SPA header's height so the chrome doesn't jump
 * when crossing between static and SPA pages.
 *
 * On phones (max-sm) and short landscape viewports the bar scrolls away
 * with the page instead of pinning — vertical space is too precious there.
 * The nav row is priority+overflow (issue #639): the links that fit stay in
 * the row and the rest fold into a "More" menu, so the bar is one line at
 * every width. Keep this in sync with the SPA header in
 * react/components/Shell.tsx.
 *
 * The account slot is the one scripted part of the static chrome. These pages
 * are prerendered and edge-cached, so the build can't know who's visiting;
 * the small inline script below decides between "Sign in" and the account
 * menu from the localStorage hint the SPA writes (auth/client.ts), then
 * reconciles it against /api/auth/me. Signed-out visitors and crawlers make
 * no API call at all and see the markup exactly as prerendered.
 */
interface Props {
  /** Which tab to highlight, if any. */
  active?: "home" | "comp" | "flights" | "submit";
}
const { active } = Astro.props;

const tab = (isActive: boolean) =>
  `text-sm font-medium transition-colors hover:text-foreground ${
    isActive ? "text-foreground" : "text-muted-foreground"
  }`;

/** Mirrors the SPA dropdown's item styling (react/rac/menu.tsx). */
const menuItem =
  "flex w-full cursor-default items-center gap-1.5 rounded-md px-1.5 py-1 text-left text-sm outline-hidden select-none hover:bg-accent hover:text-accent-foreground focus-visible:bg-accent focus-visible:text-accent-foreground";

/**
 * The same row, plus the marking a folded nav link takes with it: the reader
 * loses the row's "you are here" when their page is the one that folded. The
 * SPA's PriorityNav marks its entry with `data-current` because RAC filters
 * `aria-current` off a MenuItem; here the attribute survives, so it does both
 * jobs at once.
 */
const navMenuItem = `${menuItem} aria-[current=page]:font-semibold aria-[current=page]:text-foreground`;
---

<!-- The glass stays full-bleed under `viewport-fit=cover`; `pt-safe` pushes
     only the bar's content below the status bar, and `px-gutter-safe` holds it
     clear of a landscape notch (issue #642). Mirrors Shell.tsx. -->
<header class="sticky top-0 z-50 border-b bg-background/70 backdrop-blur-xl backdrop-saturate-150 pt-safe max-sm:static [@media(max-height:500px)]:static">
  <nav
    aria-label="Main"
    class="mx-auto flex min-h-[60px] w-full max-w-6xl flex-wrap items-center gap-x-6 gap-y-2 px-gutter-safe py-3"
  >
    <a href="/" class="shrink-0 font-brand text-base font-semibold tracking-tight">GlideComp</a>
    <!-- Priority+overflow row (issue #639), mirroring the SPA's PriorityNav
         (react/rac/priority-nav.tsx): the links that fit stay in the row, the
         rest fold into "More" instead of wrapping the bar onto a second line.
         My Flights used to be `max-sm:hidden` here — folded is better than
         gone, because folded is still one tap away.

         Two differences from the SPA, both deliberate. The row only stops
         WRAPPING once the script below runs, so a visitor with no JavaScript
         keeps every link on the two lines this header has always used; and the
         menu panel lives outside the clipping box, because there is no portal
         to render it into. -->
    <div class="relative flex min-w-0 flex-1 items-center">
      <div
        data-priority-nav
        class="flex w-full flex-wrap items-center gap-x-6 gap-y-2"
      >
        <span data-priority-item="comp" class="shrink-0">
          <a
            href="/comp"
            class={tab(active === "comp")}
            aria-current={active === "comp" ? "page" : undefined}>Competitions</a>
        </span>
        <span data-priority-item="flights" class="shrink-0">
          <a
            href="/u/me"
            class={tab(active === "flights")}
            aria-current={active === "flights" ? "page" : undefined}>My Flights</a>
        </span>
        <!-- The one thing a pilot who has just landed came here to do, so it is
             reachable from every page rather than only the homepage. -->
        <span data-priority-item="submit" class="shrink-0">
          <a
            href="/submit"
            class={tab(active === "submit")}
            aria-current={active === "submit" ? "page" : undefined}>Submit track</a>
        </span>
      </div>
      <!-- `hidden` until the script measures: with no JavaScript nothing is
           folded, so a "More" holding nothing would be a dead control. -->
      <div data-priority-trigger hidden class="absolute inset-y-0 right-0 flex items-center">
        <button
          type="button"
          aria-haspopup="menu"
          aria-expanded="false"
          aria-controls="more-nav-panel"
          aria-label="More pages"
          data-priority-nav-trigger
          class="touch-target flex h-7 items-center gap-1 rounded-lg px-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none data-[current]:text-foreground"
        >
          More
          <!-- lucide chevron-down, inlined: these pages ship no icon runtime. -->
          <svg
            aria-hidden="true"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg
          >
        </button>
        <div
          id="more-nav-panel"
          role="menu"
          aria-label="More pages"
          data-priority-nav-panel
          hidden
          class="absolute top-full right-0 z-50 mt-1 min-w-40 rounded-lg bg-popover p-1 text-popover-foreground shadow-md ring-1 ring-foreground/10"
        >
          <a
            href="/comp"
            role="menuitem"
            tabindex="-1"
            hidden
            data-priority-entry="comp"
            aria-current={active === "comp" ? "page" : undefined}
            class={navMenuItem}>Competitions</a>
          <a
            href="/u/me"
            role="menuitem"
            tabindex="-1"
            hidden
            data-priority-entry="flights"
            aria-current={active === "flights" ? "page" : undefined}
            class={navMenuItem}>My Flights</a>
          <a
            href="/submit"
            role="menuitem"
            tabindex="-1"
            hidden
            data-priority-entry="submit"
            aria-current={active === "submit" ? "page" : undefined}
            class={navMenuItem}>Submit track</a>
        </div>
      </div>
    </div>
    <!-- Fixed h-8 either way, so swapping the pill for the avatar can't shift
         the bar. `relative` anchors the menu popover. -->
    <div class="relative ml-auto h-8" data-account>
      <!-- Plain link to the SPA sign-in page (Google + email code) — every
           sign-in path stays on /signin. This is what a signed-out visitor,
           a crawler and a no-JS browser get, unchanged from the prerender. -->
      <a
        href="/signin"
        data-account-signin
        class="inline-flex h-8 cursor-pointer items-center justify-center rounded-full bg-primary px-4 text-sm font-medium whitespace-nowrap text-primary-foreground transition-colors select-none hover:bg-primary/85"
      >
        Sign in
      </a>
      <!-- Account menu, revealed only once we know there's a session. Mirrors
           the SPA's UserMenu (avatar initials → name, Settings, Sign out). -->
      <div data-account-menu hidden>
        <button
          type="button"
          aria-label="Account menu"
          aria-haspopup="menu"
          aria-expanded="false"
          aria-controls="account-menu-panel"
          data-account-trigger
          class="flex size-8 items-center justify-center rounded-full border bg-muted text-xs font-semibold hover:bg-accent focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none"></button>
        <div
          id="account-menu-panel"
          role="menu"
          aria-label="Account"
          data-account-panel
          hidden
          class="absolute right-0 z-50 mt-1 min-w-40 rounded-lg bg-popover p-1 text-popover-foreground shadow-md ring-1 ring-foreground/10"
        >
          <p
            data-account-name
            class="max-w-56 truncate px-1.5 py-1 text-xs font-medium text-muted-foreground"
          >
          </p>
          <div class="-mx-1 my-1 h-px bg-border"></div>
          <a href="/settings" role="menuitem" tabindex="-1" class={menuItem}>Settings</a>
          <button type="button" role="menuitem" tabindex="-1" data-account-signout class={menuItem}>
            Sign out
          </button>
        </div>
      </div>
    </div>
  </nav>
</header>

<!-- Behaviour lives in public/site-header.js: a file, not an inline script,
     so the CSP can stay `script-src 'self'` (public/_headers). -->
<script is:inline src="/site-header.js"></script>
